    node_to_idx = {node:i for i, node in enumerate(nodes)}

    size = len(nodes)

    parent = list(range(size))

    def find(u):

        while parent[u] != u:

            parent[u] = parent[parent[u]]

            u = parent[u]

        return u

    def union(u, v):

        pu = find(u)

        pv = find(v)

