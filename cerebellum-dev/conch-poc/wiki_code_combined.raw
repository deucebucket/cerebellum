```python
import math

t = int(input())
MOD = 10**9 + 7

for _ in range(t):
    n = int(input())
    sum_ans = 0
    current_lcm = 1
    x = 2
    while True:
        if current_lcm > n:
            break
        # Compute M = LCM(current_lcm, x)
        g = math.gcd(current_lcm, x)
        m = current_lcm * x // g
        count = (n // current_lcm) - (n // m)
        sum_ans += x * count
        # Update current_lcm for next x
        current_lcm = m
        x += 1
    print(sum_ans % MOD)
```
