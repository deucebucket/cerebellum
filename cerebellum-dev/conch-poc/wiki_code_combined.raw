```python
import sys

def main():
    n, q = map(int, sys.stdin.readline().split())
    t = list(map(int, sys.stdin.readline().split()))
    s = list(map(int, sys.stdin.readline().split()))
    
    # Pair questions and sort by descending score, then descending time
    questions = sorted(zip(s, t), key=lambda x: (-x[0], -x[1]))
    
    # Extract times in sorted order and compute prefix sums
    prefix = [0] * (n + 1)
    for i in range(n):
        prefix[i+1] = prefix[i] + questions[i][1]
    
    # Process each query
    for _ in range(q):
        k = int(sys.stdin.readline())
        print(prefix[k])

if __name__ == "__main__":
    main()
