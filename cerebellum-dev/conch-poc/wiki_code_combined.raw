import re

widgets = {}

for line in lines:

    line = line.strip()

    if line.startswith('Widget '):

        match = re.match(r'Widget (\w+)\((\d+),(\d+)\)', line)

        name = match.group(1)

        w = int(match.group(2))

        h = int(match.group(3))

        widgets[name] = Widget(name, w, h)

    elif line.startswith('HBox '):

        name = line[5:].strip()

        widgets[name] = HBox(name)

    elif line.startswith('VBox '):

        name = line[5:].strip()

        widgets[name] = VBox(name)

    elif 'pack' in line:

        # .pack( )

        match = re.match(r'(\w+)\.pack\((\w+)\)', line)

        if not match:

            # error, but input is correct as per problem statement.

        parent_name = match.group(1)

        child_name = match.group(2)

        parent = widgets[parent_name]

        child = widgets[child_name]

        # check that parent is HBox or VBox.

        # but the input is correct, so no need to handle errors.

        parent.children.append(child)

    elif 'set_border' in line:

        match = re.match(r'(\w+)\.set_border\((\d+)\)', line)

        name = match.group(1)

        x = int(match.group(2))

        widget = widgets[name]

        widget.border = x

    elif 'set_spacing' in line:

        match = re.match(r'(\w+)\.set_spacing\((\d+)\)', line)

        name = match.group(1)

        x = int(match.group(2))

        widget = widgets[name]

        widget.spacing = x

    else:

        # invalid line, but problem says input is correct.

