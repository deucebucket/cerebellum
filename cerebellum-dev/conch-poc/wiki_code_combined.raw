class TrieNode:
    def __init__(self):
        self.children = [None, None]
        self.is_end = False

class Trie:
    def __init__(self):
        self.root = TrieNode()

    def insert(self, number):
        node = self.root
        for bit in reversed(range(22)):  # from highest to lowest
            current_bit = (number >> bit) & 1
            if not node.children[current_bit]:
                node.children[current_bit] = TrieNode()
            node = node.children[current_bit]
        node.is_end = True

    def find_subset(self, mask):
        node = self.root
        number = 0
        for bit in reversed(range(22)):
            current_bit = (mask >> bit) & 1
            # We can take 1 only if mask has the bit set
            if current_bit:
                # Try to take 1 first
                if node.children[1]:
                    node = node.children[1]
                    number |= (1 << bit)
                else:
                    # Take 0
                    if node.children[0]:
                        node = node.children[0]
                    else:
                        return -1
            else:
                # Must take 0
                if node.children[0]:
                    node = node.children[0]
                else:
                    return -1
        if node.is_end:
            return number
        else:
            return -1

