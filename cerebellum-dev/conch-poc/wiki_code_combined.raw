def count_intersection(c1, c2):

    x1, y1, r1 = c1

    x2, y2, r2 = c2

    dx = x1 - x2

    dy = y1 - y2

    d_sq = dx*dx + dy*dy

    d = math.sqrt(d_sq)

    sum_r = r1 + r2

    diff_r = abs(r1 - r2)

    if d > sum_r or d < diff_r:

        return 0

    elif d == sum_r or d == diff_r:

        return 1

    else:

        return 2

