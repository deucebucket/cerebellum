Then, the parsing code:

import re

n = int(input())
widgets = {}

for _ in range(n):
    line = input().strip()
    if line.startswith('Widget '):
        # Widget name(x,y)
        match = re.fullmatch(r'Widget (\w+)\((\d+),(\d+)\)', line)
        name = match.group(1)
        w = int(match.group(2))
        h = int(match.group(3))
        widgets[name] = Widget(name, w, h)
    elif line.startswith('HBox '):
        name = line[5:]
        widgets[name] = HBox(name)
    elif line.startswith('VBox '):
        name = line[5:]
        widgets[name] = VBox(name)
    elif 'pack(' in line:
        # name1.pack(name2)
        match = re.fullmatch(r'(\w+)\.pack\((\w+)\)', line)
        parent_name = match.group(1)
        child_name = match.group(2)
        parent = widgets[parent_name]
        child = widgets[child_name]
        parent.children.append(child)
    elif 'set_border(' in line:
        match = re.fullmatch(r'(\w+)\.set_border\((\d+)\)', line)
        name = match.group(1)
        x = int(match.group(2))
        widget = widgets[name]
        widget.border = x
    elif 'set_spacing(' in line:
        match = re.fullmatch(r'(\w+)\.set_spacing\((\d+)\)', line)
        name = match.group(1)
        x = int(match.group(2))
        widget = widgets[name]
        widget.spacing = x

# Collect all widget names in lex order and output their sizes
for name in sorted(widgets.keys()):
    widget = widgets[name]
    width, height = widget.get_size()
    print(f"{name} {width} {height}")

