import bisect

n = int(input())
a = list(map(int, input().split()))
q = int(input())

pos = [[] for _ in range(101)]  # pos[0] unused

for i in range(n):
    val = a[i]
    pos[val].append(i+1)  # 1-based index

for _ in range(q):
    l, r, x, y = map(int, input().split())
    if x == y:
        continue
    lst = pos[x]
    left = bisect.bisect_left(lst, l)
    right_idx = bisect.bisect_right(lst, r)
    if left >= right_idx:
        continue
    to_move = lst[left:right_idx]
    # Update pos[x]
    pos[x] = lst[:left] + lst[right_idx:]
    # Merge into pos[y]
    target = pos[y]
    merged = []
    i = j = 0
    len_t = len(target)
    len_m = len(to_move)
    while i < len_t and j < len_m:
        if target[i] < to_move[j]:
            merged.append(target[i])
            i += 1
        else:
            merged.append(to_move[j])
            j += 1
    merged.extend(target[i:])
    merged.extend(to_move[j:])
    pos[y] = merged

# Reconstruct the array
result = [0] * n
for val in range(1, 101):
    for idx in pos[val]:
        result[idx-1] = val

print(' '.join(map(str, result)))

