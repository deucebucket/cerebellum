class FenwickTree:
    def __init__(self, size):
        self.n = size
        self.tree = [0] * (self.n + 2)  # +2 to handle 1-based indexing and avoid issues
    
    def update(self, idx, value):
        # Update the tree to have the maximum value at idx
        while idx <= self.n:
            if self.tree[idx] < value:
                self.tree[idx] = value
            else:
                break  # since we're updating with max, once we hit a node with higher value, stop
            idx += idx & -idx
    
    def query(self, idx):
        # Query the maximum value from 1 to idx
        res = 0
        while idx > 0:
            if self.tree[idx] > res:
                res = self.tree[idx]
            idx -= idx & -idx
        return res

