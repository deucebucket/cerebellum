```python
import sys
from collections import deque

def main():
    h, w = map(int, sys.stdin.readline().split())
    c_h, c_w = map(int, sys.stdin.readline().split())
    d_h, d_w = map(int, sys.stdin.readline().split())
    start = (c_h - 1, c_w - 1)
    end = (d_h - 1, d_w - 1)
    
    grid = []
    for _ in range(h):
        s = sys.stdin.readline().strip()
        grid.append(list(s))
    
    dist = [[float('inf')] * w for _ in range(h)]
    i_start, j_start = start
    dist[i_start][j_start] = 0
    
    dq = deque()
    dq.append((i_start, j_start, 0))
    
    dirs = [(-1, 0), (1, 0), (0, -1), (0, 1)]
    
    while dq:
        i, j, d = dq.popleft()
        if (i, j) == end:
            print(d)
            return
        if d > dist[i][j]:
            continue
        # Move A
        for di, dj in dirs:
            ni, nj = i + di, j + dj
            if 0 <= ni < h and 0 <= nj < w and grid[ni][nj] == '.':
                if dist[ni][nj] > d:
                    dist[ni][nj] = d
                    dq.appendleft((ni, nj, d))
        # Move B
        for dx in range(-2, 3):
            for dy in range(-2, 3):
                x = i + dx
                y = j + dy
                if 0 <= x < h and 0 <= y < w and grid[x][y] == '.':
                    if dist[x][y] > d + 1:
                        dist[x][y] = d + 1
                        dq.append((x, y, d + 1))
    print(-1)

if __name__ == "__main__":
    main()
```
