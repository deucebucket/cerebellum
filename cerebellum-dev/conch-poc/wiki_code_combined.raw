Now, BFS:

from collections import deque

visited = set()

queue = deque()

queue.append( (initial_state, 0) )

visited.add(initial_state)

while queue is not empty:

    current_state, steps = queue.popleft()

    if current_state[0] == target:

        print(steps)

        proceed to next dataset.

    generate all possible subsets.

    for each subset:

        possible_moves = {}

        for i in subset:

            if i == 0:

                current_pos = current_state[i]

                next_pos = current_state[i+1]

                # find neighbors of current_pos that are adjacent to next_pos.

                new_pos_candidates = [ (current_pos[0] + dx, current_pos[1] + dy) for dx, dy in [(1,0), (0,1), (-1,1), (-1,0), (0,-1), (1,-1)] ]

                new_pos_candidates = [p for p in new_pos_candidates if are_adjacent(p, next_pos) and p != current_pos]

                if not new_pos_candidates:

                    break

                possible_moves[i] = new_pos_candidates

            elif i == n-1:

                current_pos = current_state[i]

                prev_pos = current_state[i-1]

                new_pos_candidates = [ (current_pos[0] + dx, current_pos[1] + dy) for dx, dy in [(1,0), (0,1), (-1,1), (-1,0), (0,-1), (1,-1)] ]

                new_pos_candidates = [p for p in new_pos_candidates if are_adjacent(p, prev_pos) and p != current_pos]

                if not new_pos_candidates:

                    break

                possible_moves[i] = new_pos_candidates

            else:

                prev_pos = current_state[i-1]

                next_pos = current_state[i+1]

                # find common neighbors of prev_pos and next_pos.

                common = []

                for p in get_neighbors(prev_pos):

                    if are_adjacent(p, next_pos):

                        common.append(p)

                current_pos = current_state[i]

                new_pos_candidates = [p for p in common if p != current_pos]

                if not new_pos_candidates:

                    break

                possible_moves[i] = new_pos_candidates

        else:

            # all sections in subset have possible moves.

            # generate all combinations of moves.

            # possible_moves is a dict: i -> list of possible new positions.

            # for each i in subset, take the product of their possible moves.

            # use itertools.product to generate all combinations.

            # but since for middle sections, possible_moves[i] has length 1 or 0, it's manageable.

            # so, collect the lists for each i in subset.

            import itertools

            # get the lists for each i in subset in order.

            keys = sorted(subset)

            lists = [possible_moves[i] for i in keys]

            # generate the Cartesian product.

            for combination in itertools.product(*lists):

                # create new_positions as a copy of current_state.

                new_positions = list(current_state)

                for idx, pos in zip(keys, combination):

                    new_positions[idx] = pos

                # check rocks:

                valid = True

                for idx in keys:

                    if new_positions[idx] in rocks:

                        valid = False

                        break

                if not valid:

                    continue

                # check overlap:

                positions = new_positions

                seen = set()

                for pos in positions:

                    if pos in seen:

                        valid = False

                        break

                    seen.add(pos)

