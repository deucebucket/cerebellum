import math
import bisect

a, b = map(int, input().split())

g = math.gcd(a, b)

divisors = set()

for i in range(1, int(g**0.5) + 1):

    if g % i == 0:

        divisors.add(i)

        divisors.add(g // i)

divisors = sorted(divisors)  # sorted in ascending order

n = int(input())

for _ in range(n):

    low, high = map(int, input().split())

    # Find the largest d <= high

    idx = bisect.bisect_right(divisors, high) -1

    if idx >=0:

        d = divisors[idx]

        if d >= low:

            print(d)

            continue

    print(-1)

