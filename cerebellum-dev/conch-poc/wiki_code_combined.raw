Another approach is to use a class-based segment tree:

class SegmentTreeNode:
    def __init__(self, l, r):
        self.l = l
        self.r = r
        self.left = None
        self.right = None
        self.mask = 0
        self.lazy = None

def build(l, r, data):
    node = SegmentTreeNode(l, r)
    if l == r:
        node.mask = 1 << (data[l]-1)
    else:
        mid = (l + r) // 2
        node.left = build(l, mid, data)
        node.right = build(mid+1, r, data)
        node.mask = node.left.mask | node.right.mask
    return node

def push(node):
    if node.lazy is not None and node.left:
        # propagate to children
        c = node.lazy
        node.left.mask = 1 << (c-1)
        node.left.lazy = c
        node.right.mask = 1 << (c-1)
        node.right.lazy = c
        node.lazy = None

def update_range(node, a, b, c):
    if node.r < a or node.l > b:
        return
    if a <= node.l and node.r <= b:
        node.mask = 1 << (c-1)
        node.lazy = c
        return
    push(node)
    update_range(node.left, a, b, c)
    update_range(node.right, a, b, c)
    node.mask = node.left.mask | node.right.mask

def query_range(node, a, b):
    if node.r < a or node.l > b:
        return 0
    if a <= node.l and node.r <= b:
        return node.mask
    push(node)
    return query_range(node.left, a, b) | query_range(node.right, a, b)

This is a recursive implementation. The root is built with build(0, n-1, data).

This approach is more straightforward and correctly handles the exact ranges. But for large n (4e5), this recursive approach may hit the recursion limit in Python. For example, with 4e5 nodes, the depth is log2(4e5) ~ 19, which is manageable.

But in Python, the default recursion depth is 1000, so 19 is acceptable.

