```python
class FenwickTree:
    def __init__(self, size):
        self.n = size
        self.tree = [0] * (self.n + 2)  # 1-based indexing

    def update(self, idx, value):
        while idx <= self.n:
            if self.tree[idx] < value:
                self.tree[idx] = value
            else:
                break  # No need to update further if current value is not larger
            idx += idx & -idx

    def query(self, idx):
        res = 0
        while idx > 0:
            if self.tree[idx] > res:
                res = self.tree[idx]
            idx -= idx & -idx
        return res

n = int(input())
x = list(map(int, input().split()))
total = sum(x)
ft = FenwickTree(n)
max_sum = 0
for num in x:
    prev_max = ft.query(num - 1)
    current = prev_max + num
    ft.update(num, current)
    if current > max_sum:
        max_sum = current
print(total - max_sum)
```
