def multiply(A, B, mod):

    m = len(A)

    result = [[0] * m for _ in range(m)]

    for i in range(m):

        for k in range(m):

            if A[i][k] == 0:

                continue  # optimization to skip zero entries

            for j in range(m):

                result[i][j] = (result[i][j] + A[i][k] * B[k][j]) % mod

    return result

But for m=52, this is 52*52*52 = 140,608 operations per multiply, which is manageable.

