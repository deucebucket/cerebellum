b = list(map(int, input().split()))

x = int(input())

# Compute min_a

def compute_min_sums(arr):

    length = len(arr)

    min_sums = [float('inf')] * (length +1)  # min_sums[k] is for subarrays of length k

    for k in range(1, length +1):

        current_sum = sum(arr[:k])

        min_sum = current_sum

        for i in range(1, length -k +1):

            current_sum = current_sum - arr[i-1] + arr[i +k -1]

            if current_sum < min_sum:

                min_sum = current_sum

        min_sums[k] = min_sum

    return min_sums

min_a = compute_min_sums(a)

min_b = compute_min_sums(b)

max_area =0

# Now, iterate for each possible k in a's min_sums, find the max l in b's min_sums.

for k in range(1, len(min_a)):

    a_sum = min_a[k]

    if a_sum ==0:

        continue  # impossible since a_i >=1, sum >=k*1 >=1

    if a_sum >x:

        continue

    max_b_sum = x // a_sum

    if max_b_sum <1:

        continue

    current_max_l =0

    for l in range(1, len(min_b)):

        if min_b[l] <= max_b_sum:

            if l > current_max_l:

                current_max_l = l

    if current_max_l >0:

        max_area = max(max_area, k * current_max_l)

