import math
import bisect

a, b = map(int, input().split())
g = math.gcd(a, b)

divisors = set()
for i in range(1, int(math.isqrt(g)) + 1):
    if g % i == 0:
        divisors.add(i)
        divisors.add(g // i)

divisors = sorted(divisors)

n = int(input())
for _ in range(n):
    low, high = map(int, input().split())
    idx = bisect.bisect_right(divisors, high) - 1
    if idx >= 0 and divisors[idx] >= low:
