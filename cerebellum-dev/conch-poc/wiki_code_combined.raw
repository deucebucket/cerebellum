def bfs(start_x, start_y, end_x, end_y, vertical, horizontal):
    from collections import deque
    visited = set()
    q = deque()
    q.append( (start_x, start_y, 0) )
    visited.add( (start_x, start_y) )
    while q:
        x, y, dist = q.popleft()
        if x == end_x and y == end_y:
            return dist
        # Check east
        if (x+1, y) not in vertical:  # no wall between x and x+1
            nx = x + 1
            ny = y
            if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in visited:
                visited.add( (nx, ny) )
                q.append( (nx, ny, dist + 1) )
        # Check west
        if (x, y) not in vertical:  # no wall between x-1 and x
            nx = x - 1
            ny = y
            if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in visited:
                visited.add( (nx, ny) )
                q.append( (nx, ny, dist + 1) )
        # Check north
        if (x, y) not in horizontal:  # no wall between y and y+1
            nx = x
            ny = y + 1
            if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in visited:
                visited.add( (nx, ny) )
                q.append( (nx, ny, dist + 1) )
        # Check south
        if (x, y - 1) not in horizontal:  # no wall between y-1 and y
            nx = x
            ny = y - 1
            if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in visited:
                visited.add( (nx, ny) )
                q.append( (nx, ny, dist + 1) )
    return -1

