n, m = map(int, input().split())
a = list(map(int, input().split()))
a.sort()

prefix = [0] * (n + 1)
for i in range(n):
    prefix[i+1] = prefix[i] + a[i]

max_take = min(m, n)
min_sum = float('inf')
for k in range(0, max_take +1):
    current_sum = prefix[k]
    if current_sum < min_sum:
        min_sum = current_sum

result = max(0, -min_sum)
print(result)

