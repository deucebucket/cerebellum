So the code:

def compute_operations(N, a):
    sum_a = sum(a)
    K_low = max(0, sum_a - N * (N -1))
    left = K_low
    right = K_low + 10**18  # Arbitrary large number

    def f(K):
        total = 0
        for ai in a:
            total += (ai + K + 1) // (N + 1)
        return total

    # Binary search between left and right
    answer = None
    while left <= right:
        mid = (left + right) // 2
        current_f = f(mid)
        if current_f <= mid:
            # Possible, try to find smaller K
            answer = mid
            right = mid - 1
        else:
            left = mid + 1

    return answer

