                    parent[current_root] = root_x

                    rank[root_x] += rank[current_root]

                else:

                    parent[root_x] = current_root

                    rank[current_root] += rank[root_x]

                    root_x = current_root

            next_arr[current] = y +1

            current = next_current

    else:

        # type 3: check x and y.

        if find(x) == find(y):

            print("YES")

        else:

            print("NO")

