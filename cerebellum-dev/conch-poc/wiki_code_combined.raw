n = int(input())
A = list(map(int, input().split()))
sum_odd = sum(A[i] for i in range(0, n, 2))
sum_even = sum(A[i] for i in range(1, n, 2))
R = [0] * n
R[0] = sum_odd - sum_even
for i in range(1, n):
    R[i] = 2 * A[i-1] - R[i-1]
print(' '.join(map(str, R)))

