D, N = map(int, input().split())

t = [0] * (D + 1)
for i in range(1, D + 1):
    t[i] = int(input())

clothes = []
for _ in range(N):
    a, b, c = map(int, input().split())
    clothes.append((a, b, c))

eligible = [[] for _ in range(D + 1)]
