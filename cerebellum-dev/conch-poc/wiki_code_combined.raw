def bfs(start_x, start_y, end_x, end_y, vertical_edges, horizontal_edges, candidate_edge=None, candidate_type=None):

    # candidate_edge is a tuple (x, y)

    # candidate_type is 'vertical' or 'horizontal'

    visited = [[False for _ in range(H)] for _ in range(W)]

    queue = deque()

    queue.append( (start_x, start_y, 0) )

    visited[start_x][start_y] = True

    while queue:

        x, y, steps = queue.popleft()

        if x == end_x and y == end_y:

            return steps

        # Check all four directions

        # Right

        if x + 1 < W:

            # Check vertical edge (x+1, y)

            blocked = ( (x+1, y) in vertical_edges )

            if candidate_type == 'vertical' and (x+1, y) == candidate_edge:

                blocked = True

            if not blocked and not visited[x+1][y]:

                visited[x+1][y] = True

                queue.append( (x+1, y, steps+1) )

        # Left

        if x > 0:

            blocked = ( (x, y) in vertical_edges )

            if candidate_type == 'vertical' and (x, y) == candidate_edge:

                blocked = True

            if not blocked and not visited[x-1][y]:

                visited[x-1][y] = True

                queue.append( (x-1, y, steps+1) )

        # Up

        if y + 1 < H:

            blocked = ( (x, y+1) in horizontal_edges )

            if candidate_type == 'horizontal' and (x, y+1) == candidate_edge:

                blocked = True

            if not blocked and not visited[x][y+1]:

                visited[x][y+1] = True

                queue.append( (x, y+1, steps+1) )

        # Down

        if y > 0:

            blocked = ( (x, y) in horizontal_edges )

            if candidate_type == 'horizontal' and (x, y) == candidate_edge:

                blocked = True

            if not blocked and not visited[x][y-1]:

                visited[x][y-1] = True

                queue.append( (x, y-1, steps+1) )

    return None  # No path

