def factorize(q):

    factors = {}

    i = 2

    while i*i <= q:

        while q % i ==0:

            factors[i] = factors.get(i,0) +1

            q = q //i

        i +=1

    if q >1:

        factors[q] = factors.get(q,0)+1

    return factors

