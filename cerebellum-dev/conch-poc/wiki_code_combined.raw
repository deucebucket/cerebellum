from collections import defaultdict

n = int(input())
strings = [input().strip() for _ in range(n)]
if n == 0:
    print(0)
    exit()
L = len(strings[0])
dp = {(None, None): 0}

for s in strings:
    next_dp = defaultdict(int)
    for (a, b), current_sum in dp.items():
        # Option 1: add to first subsequence
        if a is None:
            new_a = s
            added = 0
        else:
            max_k = 0
            for k in range(min(len(a), L), 0, -1):
                if a.endswith(s[:k]):
                    max_k = k
                    break
            new_a = (a[:L - max_k] + s)[-L:]
            added = max_k
        new_state1 = (new_a, b)
        if next_dp[new_state1] < current_sum + added:
            next_dp[new_state1] = current_sum + added

        # Option 2: add to second subsequence
        if b is None:
            new_b = s
            added = 0
        else:
            max_k = 0
            for k in range(min(len(b), L), 0, -1):
                if b.endswith(s[:k]):
                    max_k = k
                    break
            new_b = (b[:L - max_k] + s)[-L:]
            added = max_k
        new_state2 = (a, new_b)
        if next_dp[new_state2] < current_sum + added:
            next_dp[new_state2] = current_sum + added

    dp = next_dp

if not dp:
    print(0)
else:
    max_sum = max(dp.values())
    print(n * L - max_sum)

