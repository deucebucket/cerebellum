    x = query[1]

    y = query[2]

    if typ ==1:

        u = find(x)

        v = find(y)

        if u != v:

            if rank[u] >= rank[v]:

                parent[v] = u

                rank[u] += rank[v]

            else:

                parent[u] = v

                rank[v] += rank[u]

    elif typ ==2:

        if x > y:

            continue

        current =x

        root_x = find(x)

