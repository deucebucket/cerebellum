            b = S[0] - E[0]

            c = E[0] * S[1] - S[0] * E[1]

            denominator = math.hypot(a, b)

            if denominator == 0:

                return False

            distance = abs(c) / denominator

            if distance > r:

                return False

            dx = E[0] - S[0]

            dy = E[1] - S[1]

            t_numerator = (-S[0] * dx - S[1] * dy)

            t_denominator = dx*dx + dy*dy

            if t_denominator == 0:

                return False

            t = t_numerator / t_denominator

            return 0 <= t <= 1

        if intersects(S, E, r):

            # Compute minimal distance via tangents and arc

            # Compute S and E's positions

            d1 = math.hypot(S[0], S[1])

            d2 = math.hypot(E[0], E[1])

            t1 = math.sqrt(d1**2 - r**2)

            t2 = math.sqrt(d2**2 - r**2)

