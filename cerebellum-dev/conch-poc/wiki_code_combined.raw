def bfs_person(n, m, grid):
    from collections import deque
    visited = [[[False for _ in range(4)] for _ in range(m)] for _ in range(n)]
    directions = [ (0,1), (1,0), (0,-1), (-1,0) ]  # right, down, left, up
    q = deque()
    q.append( (0, 0, 0) )  # (x, y, dir: 0=right)
    visited[0][0][0] = True
    while q:
        x, y, d = q.popleft()
        dx, dy = directions[d]
        nx = x + dx
        ny = y + dy
        if 0 <= nx < n and 0 <= ny < m:
            if grid[nx][ny] == '#':
                # regular column, continue in same direction
                if not visited[nx][ny][d]:
                    visited[nx][ny][d] = True
                    q.append( (nx, ny, d) )
            else:
                # empty cell, continue in same direction
                if not visited[nx][ny][d]:
                    visited[nx][ny][d] = True
                    q.append( (nx, ny, d) )
        # else, out of bounds, stop
    # Mark all cells that are reachable in any direction
    reachable_person = [ [False for _ in range(m)] for _ in range(n) ]
    for i in range(n):
        for j in range(m):
            for d in range(4):
                if visited[i][j][d]:
                    reachable_person[i][j] = True
    return reachable_person

