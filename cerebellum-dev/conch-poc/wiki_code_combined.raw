def get_kth_magical(K):

    if K == 0:

        return 0

    n = K -1

    if n ==0:

        return 0

    digits = []

    while n>0:

        digits.append(n%5)

        n = n//5

    digits = digits[::-1]

    s = ''.join(str(2*d) for d in digits)

    return int(s)

