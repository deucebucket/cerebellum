            blocked = (x, y) in horizontal_edges
            if candidate_type == 'horizontal' and (x, y) == candidate_edge:
                blocked = True
            if not blocked and not visited[x][y-1]:
                visited[x][y-1] = True
                queue.append( (x, y-1, steps + 1) )
    return None

