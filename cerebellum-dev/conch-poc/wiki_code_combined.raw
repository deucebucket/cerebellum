import heapq

h, w, K = map(int, input().split())
grid = []
s_pos = None
e_pos = None
a_positions = []
for i in range(h):
    row = list(input().strip().replace(' ', ''))
    for j in range(w):
        if row[j] == 's':
            s_pos = (i, j)
        elif row[j] == 'e':
            e_pos = (i, j)
        elif row[j] == 'a':
            a_positions.append( (i,j) )
    grid.append(row)

m = len(a_positions)
if m < K:
    print(-1)
    exit()

# Assign indices to a_positions
a_index = { pos: idx for idx, pos in enumerate(a_positions) }

visited = [ [ dict() for _ in range(w) ] for _ in range(h) ]

heap = []
heapq.heappush(heap, (0, s_pos[0], s_pos[1], 0))

found = False
answer = -1

dirs = [ (-1,0), (1,0), (0,-1), (0,1) ]

while heap:
    steps, i, j, mask = heapq.heappop(heap)
    if i == e_pos[0] and j == e_pos[1]:
        if bin(mask).count('1') >= K:
            answer = steps
            found = True
            break
        else:
            continue
    if mask in visited[i][j]:
        if visited[i][j][mask] <= steps:
            continue
    visited[i][j][mask] = steps
    for dx, dy in dirs:
        ni = i + dx
        nj = j + dy
        if 0 <= ni < h and 0 <= nj < w:
            cell = grid[ni][nj]
            if cell == '#':
                continue
            new_mask = mask
            if cell == 'a' and (ni, nj) in a_index:
                idx = a_index[(ni, nj)]
                if not (mask & (1 << idx)):
                    new_mask = mask | (1 << idx)
            new_steps = steps + 1
            if cell == 'e':
                if bin(new_mask).count('1') >= K:
                    answer = new_steps
                    found = True
                    print(new_steps)
                    exit()
            if new_mask in visited[ni][nj]:
                if visited[ni][nj][new_mask] <= new_steps:
                    continue
            # Check if this state is already in the heap with a lower step count?
            # It's possible, but heapq will process the lower steps first, so when this state is popped, if a lower steps exists, we'll skip.
            heapq.heappush(heap, (new_steps, ni, nj, new_mask))

print(answer if found else -1)

