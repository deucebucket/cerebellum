```python
MOD = 10**9 + 7

def main():
    import sys
    from collections import defaultdict

    N, W = map(int, sys.stdin.readline().split())
    a = [int(sys.stdin.readline()) for _ in range(N)]
    a.sort()
    max_mr = N  # Represents 'no excluded elements yet'
    
    current_states = defaultdict(int)
    current_states[(0, max_mr)] = 1
    
    for i in range(N):
        ai = a[i]
        next_states = defaultdict(int)
        for (sum_, mr), cnt in current_states.items():
            # Include ai
            new_sum = sum_ + ai
            if new_sum <= W:
                new_mr = mr
                next_states[(new_sum, new_mr)] = (next_states[(new_sum, new_mr)] + cnt) % MOD
            # Exclude ai
            new_sum = sum_
            if mr == max_mr:
                new_mr = i
            else:
                new_mr = mr
            next_states[(new_sum, new_mr)] = (next_states[(new_sum, new_mr)] + cnt) % MOD
        current_states = next_states
    
    ans = 0
    for (sum_, mr), cnt in current_states.items():
        if sum_ > W:
            continue
        if mr == max_mr:
            ans = (ans + cnt) % MOD
        else:
            required = W - a[mr]
            if sum_ > required:
                ans = (ans + cnt) % MOD
    print(ans % MOD)

if __name__ == "__main__":
    main()
```
