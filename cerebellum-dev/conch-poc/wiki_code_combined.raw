Sample code:

import math
from scipy.optimize import differential_evolution

def main():
    import sys
    input = sys.stdin.read().split()
    ptr =0
    while True:
        n, m = map(int, input[ptr:ptr+2])
        ptr +=2
        if n ==0 and m ==0:
            break
        airports = []
        for _ in range(n):
            x, y = map(int, input[ptr:ptr+2])
            ptr +=2
            airports.append( (x, y) )
        flights = []
        for _ in range(m):
            a = int(input[ptr])-1 # convert to 0-based
            b = int(input[ptr+1])-1
            vj = float(input[ptr+2])
            ptr +=3
            # compute original_time
            ax, ay = airports[a]
            bx, by = airports[b]
            dx = ax - bx
            dy = ay - by
            distance = math.hypot(dx, dy)
            original_time = distance / vj
            flights.append( (a, original_time, vj) )
        # Define bounds for optimization
        if not airports:
            continue
        min_x = min(a[0] for a in airports) - 1000
        max_x = max(a[0] for a in airports) + 1000
        min_y = min(a[1] for a in airports) - 1000
        max_y = max(a[1] for a in airports) + 1000
        bounds = [ (min_x, max_x), (min_y, max_y), (min_x, max_x), (min_y, max_y) ]
        # Define the objective function
        def objective(params):
            x1, y1, x2, y2 = params
            total =0.0
            for a_idx, original_time, vj in flights:
                ax, ay = airports[a_idx]
                d_w1 = math.hypot(ax -x1, ay - y1)
                time_w1 = d_w1 / vj
                d_w2 = math.hypot(ax -x2, ay - y2)
                time_w2 = d_w2 / vj
                tj = min(original_time, time_w1, time_w2)
                total += tj **2
            return total
        # Run differential_evolution
        result = differential_evolution(objective, bounds, maxiter=100, popsize=15, tol=1e-7, polish=True)
        minimal_sum = result.fun
        rms = math.sqrt( minimal_sum / m )
        print("{0:.6f}".format(rms))
        
if __name__ == '__main__':
    main()

