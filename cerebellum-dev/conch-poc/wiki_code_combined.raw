for i in range(2, max_num + 1):
    if spf[i] == 0:
        spf[i] = i
        if i * i <= max_num:
            for j in range(i * i, max_num + 1, i):
                if spf[j] == 0:
                    spf[j] = i

def sum_exponents(n):
    if n == 1:
        return 0
    res = 0
    while n != 1:
        p = spf[n]
        count = 0
        while n % p == 0:
            count += 1
            n = n // p
        res += count
    return res

n = int(input())
a = list(map(int, input().split()))

xor = 0
for num in a:
    xor ^= sum_exponents(num)

print("ALICE" if xor != 0 else "BOB")
