# Read input
M, N, X, Y = map(int, input().split())

cells = []
for _ in range(M * N):
    data = list(map(int, input().split()))
    cells.append(data)

steps, direction = input().split()
steps = int(steps)

# Directions: N, E, S, W
dir_map = {'N': 0, 'E': 1, 'S': 2, 'W': 3}
dx = [-1, 0, 1, 0]
dy = [0, 1, 0, -1]

current_dir = dir_map[direction]
current_x = X
current_y = Y

positions = set()
positions.add((current_x, current_y))

for _ in range(steps):
    # Get cell index (0-based)
    cell_index = (current_x - 1) * N + (current_y - 1)
    cell = cells[cell_index]
    code = cell[current_dir]
    
    # Parse code: assuming code is direction (0-3) and steps (1)
    # This is a guess and may need adjustment
    new_dir = (code - 1) % 4  # code 1:0, 2:1, etc.
    step_count = 1  # assuming step count is 1
    
    # Update direction
    current_dir = new_dir
    
    # Move step_count steps
    for _ in range(step_count):
        new_x = current_x + dx[current_dir]
        new_y = current_y + dy[current_dir]
        
        # Check boundaries
        if 1 <= new_x <= M and 1 <= new_y <= N:
            current_x, current_y = new_x, new_y
            positions.add((current_x, current_y))

# Output sorted positions
for pos in sorted(positions):
    print(pos[0], pos[1])
