MOD = 10**9+7

def is_lucky(x):
    s = str(x)
    for c in s:
        if c not in {'4', '7'}:
            return False
    return True

n, k = map(int, input().split())
a = list(map(int, input().split()))

lucky_freq = dict()
non_lucky = 0

for num in a:
    if is_lucky(num):
        if num in lucky_freq:
            lucky_freq[num] +=1
        else:
            lucky_freq[num] =1
    else:
        non_lucky +=1

lc = list(lucky_freq.values())
m_lucky = len(lc)

# Compute elementary symmetric sums
max_es = m_lucky
es = [0]*(max_es +1)
es[0] =1
for cnt in lc:
    # Update the es array
    for m in range(max_es, 0, -1):
        es[m] = (es[m] + es[m-1] * cnt) % MOD

# Precompute factorial and inv factorial for combinations
max_fact = max(non_lucky, k) + 10  # To handle up to non_lucky and k-m
fact = [1]*(max_fact +1)
for i in range(1, max_fact+1):
    fact[i] = fact[i-1] * i % MOD

inv_fact = [1]*(max_fact +1)
inv_fact[max_fact] = pow(fact[max_fact], MOD-2, MOD)
for i in range(max_fact-1, -1, -1):
    inv_fact[i] = inv_fact[i+1] * (i+1) % MOD

def comb(n, r):
    if r <0 or r >n:
        return 0
    return fact[n] * inv_fact[r] % MOD * inv_fact[n -r] % MOD

total =0
for m in range(0, min(m_lucky, k) +1):
    # m is the number of unique lucky numbers chosen
    t = k - m
    if t <0 or t > non_lucky:
        continue
    if m > len(lc):
        continue
    sum_es = es[m]
    sum_comb = comb(non_lucky, t)
    total = (total + sum_es * sum_comb) % MOD

print(total % MOD)

