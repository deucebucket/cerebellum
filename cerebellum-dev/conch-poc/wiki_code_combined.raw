Now, code:

MOD = 10**9 +7

n, m, k = map(int, input().split())

if n ==1:

    print(m % MOD)

else:

    forbidden = set()

    for _ in range(k):

        s = input().strip()

        a_char, b_char = s[0], s[1]

        # convert to numbers

        if a_char.islower():

            a = ord(a_char) - ord('a') +1

        else:

            a = ord(a_char) - ord('A') +27

        if b_char.islower():

            b = ord(b_char) - ord('a') +1

        else:

            b = ord(b_char) - ord('A') +27

        forbidden.add( (a, b) )

    # build transition matrix

    T = [ [1]*m for _ in range(m) ]

    for a, b in forbidden:

        i = a-1

        j = b-1

        if i < m and j <m:  # just in case, but problem says they are <=m

            T[i][j] =0

    def multiply(A, B, mod):

        m = len(A)

        result = [ [0]*m for _ in range(m) ]

        for i in range(m):

            for k in range(m):

                if A[i][k] ==0:

                    continue

                for j in range(m):

                    result[i][j] = (result[i][j] + A[i][k] * B[k][j]) % mod

        return result

    def matrix_power(mat, power, mod):

        # Initialize result as identity matrix

        m = len(mat)

        result = [ [0]*m for _ in range(m) ]

        for i in range(m):

            result[i][i] =1

        current = mat

        while power >0:

            if power %2 ==1:

                result = multiply(result, current, mod)

            current = multiply(current, current, mod)

            power = power //2

        return result

    power = n-1

    T_power = matrix_power(T, power, MOD)

    total =0

    for row in T_power:

        total = (total + sum(row)) % MOD

    print(total)

