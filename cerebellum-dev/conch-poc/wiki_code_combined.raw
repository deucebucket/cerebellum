```python
n = int(input())
a = list(map(int, input().split()))
b = list(map(int, input().split()))
c = list(map(int, input().split()))

from collections import Counter

count_a = Counter(a)
count_b = Counter(b)
count_c = Counter(c)

first = None
for num in a:
    if count_b.get(num, 0) < count_a[num]:
        first = num
        break

second = None
for num in b:
    if count_c.get(num, 0) < count_b[num]:
        second = num
        break

print(first)
print(second)
```
 = = Related works = = 

