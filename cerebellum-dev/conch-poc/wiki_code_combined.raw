```python
n, k = map(int, input().split())
a = list(map(int, input().split()))

left = 0
max_len = 0
best_left = 0
best_right = 0
zeros = 0
best_zeros = 0

for right in range(n):
    if a[right] == 0:
        zeros += 1
    while zeros > k:
        if a[left] == 0:
            zeros -= 1
        left += 1
    current_len = right - left + 1
    if current_len > max_len:
        max_len = current_len
        best_left = left
        best_right = right
        best_zeros = zeros

modified = a.copy()
for i in range(best_left, best_right + 1):
    if modified[i] == 0:
        modified[i] = 1

rem = k - best_zeros
for i in range(n):
    if rem <= 0:
        break
    if i < best_left or i > best_right:
        if modified[i] == 0:
            modified[i] = 1
            rem -= 1

print(max_len)
print(' '.join(map(str, modified)))
```
