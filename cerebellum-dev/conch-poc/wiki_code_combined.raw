Read n, m, k.

if k > (n-1 + m-1):

    print(-1)

else:

    x_min = max(0, k - (n-1))

    x_max = min(k, m-1)

    x_opt = k // 2

    candidates = [x_min, x_max, x_opt, x_opt-1, x_opt+1, x_opt-2, x_opt+2]

    # add more candidates if needed?

    valid_x = []

    for x in candidates:

        if x >=x_min and x <=x_max:

            valid_x.append(x)

    # remove duplicates

    valid_x = list(set(valid_x))

    max_area =0

    for x in valid_x:

        y = k -x

        if y <0 or y > (n-1):

            continue

        a = m // (x +1)

        b = n // (y +1)

        current = a * b

        if current > max_area:

            max_area = current

    print(max_area if max_area >0 else -1)

