First, the is_gp function:

def is_gp(a):
    n = len(a)
    if n <= 1:
        return True
    if all(x ==0 for x in a):
        return True
    if a[0] == 0:
        return all(x ==0 for x in a)
    if a[1] ==0:
        return all(x ==0 for x in a[2:])
    numerator = a[1]
    denominator = a[0]
    for i in range(2, n):
        if a[i] * denominator != a[i-1] * numerator:
            return False
    return True

