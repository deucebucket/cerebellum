```python
import sys
from collections import deque

def bfs(start_x, start_y, end_x, end_y, vertical_walls, horizontal_walls, W, H):
    visited = set()
    q = deque()
    q.append((start_x, start_y, 0))
    visited.add((start_x, start_y))
    while q:
        x, y, dist = q.popleft()
        if x == end_x and y == end_y:
            return dist
        # East
        if (x + 1, y) not in vertical_walls:
            nx, ny = x + 1, y
            if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in visited:
                visited.add((nx, ny))
                q.append((nx, ny, dist + 1))
        # West
        if (x, y) not in vertical_walls:
            nx, ny = x - 1, y
            if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in visited:
                visited.add((nx, ny))
                q.append((nx, ny, dist + 1))
        # North
        if (x, y) not in horizontal_walls:
            nx, ny = x, y + 1
            if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in visited:
                visited.add((nx, ny))
                q.append((nx, ny, dist + 1))
        # South
        if (x, y - 1) not in horizontal_walls:
            nx, ny = x, y - 1
            if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in visited:
                visited.add((nx, ny))
                q.append((nx, ny, dist + 1))
    return -1

def main():
    W, H, N = map(int, sys.stdin.readline().split())
    vertical_walls = set()
    horizontal_walls = set()

    for y in range(H):
        vertical_walls.add((0, y))
        vertical_walls.add((W, y))
    for x in range(W):
        horizontal_walls.add((x, 0))
        horizontal_walls.add((x, H))

    for _ in range(N):
        sx, sy, dx, dy = map(int, sys.stdin.readline().split())
        if sx == dx:
            if sy > dy:
                sy, dy = dy, sy
            for y in range(sy, dy):
                vertical_walls.add((sx, y))
        else:
            if sx > dx:
                sx, dx = dx, sx
            for x in range(sx, dx):
                horizontal_walls.add((x, sy))

    ix, iy = map(int, sys.stdin.readline().split())
    ox, oy = map(int, sys.stdin.readline().split())

    original_dist = bfs(ix, iy, ox, oy, vertical_walls, horizontal_walls, W, H)
    if original_dist == -1:
        print(0)
        return

    max_increase = 0

    candidates = []
    for x in range(1, W):
        for y in range(H):
            if (x, y) not in vertical_walls:
                candidates.append(('v', x, y))
    for y in range(1, H):
        for x in range(W):
            if (x, y) not in horizontal_walls:
                candidates.append(('h', x, y))

    for type_wall, a, b in candidates:
        if type_wall == 'v':
            vertical_walls.add((a, b))
        else:
            horizontal_walls.add((a, b))

        new_dist = bfs(ix, iy, ox, oy, vertical_walls, horizontal_walls, W, H)

        if new_dist != -1:
            increase = new_dist - original_dist
            if increase > max_increase:
                max_increase = increase

        if type_wall == 'v':
            vertical_walls.remove((a, b))
        else:
            horizontal_walls.remove((a, b))

    print(max_increase)

if __name__ == "__main__":
    main()
```
