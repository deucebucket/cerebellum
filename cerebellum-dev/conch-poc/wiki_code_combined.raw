For example:

import heapq

k = int(input())
limit = 2 * k * k

# Generate (k-2) numbers
if k >= 2:
    heap = []
    visited = set()
    initial = 2 * 3
    heapq.heappush(heap, initial)
    visited.add(initial)
    result = []
    while len(result) < k-2 and heap:
        current = heapq.heappop(heap)
        result.append(current)
        for p in [2,3]:
            next_num = current * p
            if next_num <= limit and next_num not in visited:
                heapq.heappush(heap, next_num)
                visited.add(next_num)
    # Now, generate max power of 2 and 3
    max_2 = 1
    while max_2 * 2 <= limit:
        max_2 *=2
    max_3 =1
    while max_3 *3 <= limit:
        max_3 *=3
    # Combine
    beautiful_set = result + [max_2, max_3]
    # Print
    print(' '.join(map(str, beautiful_set)))
else:
    # Handle k=1, but according to input constraints, k >=10
    pass

