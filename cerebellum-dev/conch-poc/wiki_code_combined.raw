import sys
import math

def get_divisors(diff):
    divisors = set()
    for i in range(1, int(math.isqrt(diff)) +1):
        if diff % i == 0:
            divisors.add(i)
            divisors.add(diff // i)
    return divisors

def solve():
    input = sys.stdin.read().split()
    ptr = 0
    t = int(input[ptr])
    ptr +=1
    for _ in range(t):
        while ptr < len(input) and input[ptr] == '':
            ptr +=1
        n = int(input[ptr])
        ptr +=1
        s = input[ptr]
        ptr +=1
        # Collect conflicting pairs
        conflicts = []
        vs = []
        ks = []
        for i in range(n):
            c = s[i]
            if c == 'V':
                for j in ks:
                    conflicts.append(i - j)
                vs.append(i)
            elif c == 'K':
                for j in vs:
                    conflicts.append(i - j)
                ks.append(i)
        # Collect all divisors of conflicts
        invalid = set()
        for diff in conflicts:
            if diff ==0:
                continue
            divisors = get_divisors(diff)
            for d in divisors:
                if 1<=d <=n:
                    invalid.add(d)
        valid = []
        for d in range(1, n+1):
            if d not in invalid:
                valid.append(d)
        print(len(valid))
        print(' '.join(map(str, sorted(valid))))

