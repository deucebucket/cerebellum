So in code:

n, m = map(int, input().split())
grid = [input().strip() for _ in range(n)]

row_cols = []
for r in range(n):
    cols = frozenset(c for c, char in enumerate(grid[r]) if char == '#')
    row_cols.append(cols)

col_rows = []
for c in range(m):
    rows = frozenset(r for r in range(n) if grid[r][c] == '#')
    col_rows.append(rows)

from collections import defaultdict

# Check row groups
row_groups = defaultdict(list)
for r in range(n):
    s = row_cols[r]
    if s:
        row_groups[s].append(r)

for s, rows in row_groups.items():
    ri = frozenset(rows)
    for c in s:
        if col_rows[c] != ri:
            print("No")
            exit()

# Check column groups
