```python
w, m, k = map(int, input().split())

current = m
remaining = w
count = 0

while True:
    d = len(str(current))
    next_start = 10 ** d
    max_in_segment = next_start - current
    cost_per = d * k

    if cost_per > remaining:
        break

    possible = remaining // cost_per
    take = min(possible, max_in_segment)
    
    count += take
    remaining -= take * cost_per
    current += take

    if take < max_in_segment:
        break

print(count)
```
