def generate_super_lucky(k):

    # Generates all super lucky numbers with k 4s and k 7s in lex order.

    def backtrack(current, count4, count7):

        if len(current) == 2*k:

            yield current

            return

        if count4 > 0:

            yield from backtrack(current + '4', count4 -1, count7)

        if count7 > 0:

            yield from backtrack(current + '7', count4, count7 -1)

    return backtrack('', k, k)

