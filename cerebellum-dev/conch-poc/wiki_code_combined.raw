            dx = E[0] - S[0]

            dy = E[1] - S[1]

            minimal_distance = math.hypot(dx, dy)

        # Check if possible

        if minimal_distance <= v * mid:

            right = mid

        else:

            left = mid

    print("{0:.9f}".format(right))

if __name__ == "__main__":

    main()

