from bisect import bisect_left

s = input().strip()
t = input().strip()

from collections import defaultdict
char_indices = defaultdict(list)

for idx, c in enumerate(s):
    char_indices[c].append(idx)

for c in t:
    if c not in char_indices:
        print(-1)
        exit()

current_pos = 0
len_s = len(s)

for c in t:
    indices = char_indices[c]
    pos_in_s = current_pos % len_s
    idx = bisect_left(indices, pos_in_s)
    if idx < len(indices):
        # found in current s
        next_char_pos = indices[idx]
        current_pos = (current_pos // len_s) * len_s + next_char_pos + 1
    else:
        # move to next s copy
        next_char_pos = indices[0]
        current_pos = (current_pos // len_s + 1) * len_s + next_char_pos + 1

print(current_pos)

