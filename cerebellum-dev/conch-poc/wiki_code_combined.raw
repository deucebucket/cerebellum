n, m = map(int, input().split())
c = list(map(int, input().split()))
adj = [[] for _ in range(n+1)]
for _ in range(n-1):
    x, y = map(int, input().split())
    adj[x].append(y)
    adj[y].append(x)

in_time = [0]*(n+1)
out_time = [0]*(n+1)
time = 0
stack = [(1, False, -1)]

while stack:
    node, visited, parent = stack.pop()
    if not visited:
        time += 1
        in_time[node] = time
        # Push back as visited, then push children (excluding parent)
        stack.append( (node, True, parent) )
        # Push children in reverse order to process them in order
        for neighbor in reversed(adj[node]):
            if neighbor != parent:
                stack.append( (neighbor, False, node) )
    else:
        out_time[node] = time

data = [0]*n
for i in range(1, n+1):
    pos = in_time[i] - 1  # convert to 0-based
    data[pos] = c[i-1]

