```python
from itertools import combinations

n = int(input())
finance = list(map(int, input().split()))
marketing = list(map(int, input().split()))

# Create the value matrix
value = [[0] * n for _ in range(n)]
for i in range(n):
    for j in range(n):
        if finance[i] > marketing[j]:
            value[i][j] = 100
        elif finance[i] == marketing[j]:
            value[i][j] = 50
        else:
            value[i][j] = 0

max_mask = 1 << n
dp = [-float('inf')] * max_mask
dp[0] = 0

for k in range(n):
    for bits in combinations(range(n), k):
        mask = 0
        for b in bits:
            mask |= (1 << b)
        if dp[mask] == -float('inf'):
            continue
        for j in range(n):
            if not (mask & (1 << j)):
                new_mask = mask | (1 << j)
                dp[new_mask] = max(dp[new_mask], dp[mask] + value[k][j])

print(dp[(1 << n) - 1])
```
