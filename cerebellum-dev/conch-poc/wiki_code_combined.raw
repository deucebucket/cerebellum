        if F[i] > M[j]:
            value[i][j] = 100
        elif F[i] == M[j]:
            value[i][j] = 50
        else:
            value[i][j] =0

max_mask = 1 << n
dp = [-float('inf')] * max_mask
dp[0] =0

for k in range(n):
    # For all masks with exactly k bits set
    for bits in combinations(range(n), k):
        mask = 0
        for b in bits:
            mask |= (1 << b)
        current_value = dp[mask]
        if current_value == -float('inf'):
            continue  # not reachable
        # Now, try adding each j not in mask
        for j in range(n):
            if not (mask & (1 << j)):
                new_mask = mask | (1 << j)
                new_value = current_value + value[k][j]
                if new_value > dp[new_mask]:
                    dp[new_mask] = new_value

# The answer is the maximum value for the full mask
print(dp[(1<<n)-1])

