    # Compute contribution

    contribution = (sum_current[S] * (N - i)) % MOD  # since i is 0-based, the original code's i is 1-based. So in Python, for 0-based i, the last index is i (0-based). So the original formula (N - ik + 1) becomes (N - (i+1) +1) = N -i. Because the code's i is 0-based, so the original ik is i+1.

    answer = (answer + contribution) % MOD

    # Update prev

    count_prev = count_current.copy()

    sum_prev = sum_current.copy()

