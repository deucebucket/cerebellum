```python
import sys

max_n = 10000
fact = [1] * (max_n + 1)

for i in range(1, max_n + 1):
    fact[i] = fact[i-1] * i

T = int(sys.stdin.readline())
for _ in range(T):
    N = int(sys.stdin.readline())
    print(fact[N])
```
