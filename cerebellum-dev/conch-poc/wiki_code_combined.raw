```python
n, m = map(int, input().split())
floors = [list(input().strip()) for _ in range(n)]

current_floor = n
current_pos = 0
current_dir = 1  # 1 for right, -1 for left
time = 0

while True:
    if current_floor == 1:
        print(time)
        exit()
    
    floor_idx = n - current_floor
    if floor_idx + 1 < n:  # Check if floor below exists (not applicable for current_floor=1)
        floor_below = floors[floor_idx + 1]
        if 0 <= current_pos < m and floor_below[current_pos] == '.':
            time += 1
            current_floor -= 1
            continue
    
    visited = set()
    while True:
        if current_floor == 1:
            print(time)
            exit()
        
        floor_idx = n - current_floor
        floor_data = floors[floor_idx]
        can_fall = False
        # Check if can fall
        if floor_idx + 1 < n:
            floor_below = floors[floor_idx + 1]
            if 0 <= current_pos < m and floor_below[current_pos] == '.':
                time += 1
                current_floor -= 1
                can_fall = True
                break
        
        if can_fall:
            break
        
        # Determine next position and direction
        next_x = current_pos + current_dir
        if next_x < 0 or next_x >= m:
            new_dir = -current_dir
            new_pos = current_pos
        else:
            cell = floor_data[next_x]
            if cell == '.':
                new_pos = next_x
                new_dir = current_dir
            elif cell == '+':
                floor_data[next_x] = '.'
                new_dir = -current_dir
                new_pos = current_pos
            else:  # '#'
                new_dir = -current_dir
                new_pos = current_pos
        
        # Check for loop
        if (new_pos, new_dir) in visited:
            print("Never")
            exit()
        visited.add((new_pos, new_dir))
        
        current_pos = new_pos
        current_dir = new_dir
        time += 1
```
