import itertools

n = int(input())
digits = list(map(int, input().split()))
digit_set = set(digits)
required_digits = digit_set

palindromes = []

# Generate even-length palindromes
for L in range(4, 13):
    if L % 2 != 0:
        continue
    k = L // 2
    # Check if k >= len(required_digits)
    if len(required_digits) > k:
        continue
    # Generate all possible sequences of k digits that cover all required digits
    # Each sequence must contain all required digits, possibly with duplicates
    # So generate all possible sequences of length k with digits from required_digits
    # and check if all required digits are present in the sequence
    for sequence in itertools.product(digits, repeat=k):
        current_digits = set(sequence)
        if current_digits != required_digits:
            continue
        s = ''.join(map(str, sequence)) + ''.join(map(str, reversed(sequence)))
        palindromes.append(s)

# Generate odd-length palindromes
for L in range(5, 13, 2):
    k = (L - 1) // 2
    # Check if k+1 >= len(required_digits)
    if len(required_digits) > (k + 1):
        continue
    # We need to generate sequences of k digits and a middle digit such that their union is required_digits
    # For each possible missing digit d in required_digits:
    for d in required_digits:
        other_digits = required_digits - {d}
        # Generate all possible sequences of length k from other_digits
        for sequence in itertools.product(other_digits, repeat=k):
            # The middle digit is d
            s = ''.join(map(str, sequence)) + str(d) + ''.join(map(str, reversed(sequence)))
            # Check if the entire s contains all required digits
            # But since sequence is from other_digits (size len(required_digits)-1), and middle is d, the combined digits are other_digits ∪ {d} → required_digits
            # So no need to check again
            palindromes.append(s)

valid_ips = set()

for s in palindromes:
    L = len(s)
    # Generate all possible splits into four parts of 1-3 digits each, summing to L
    splits = []
    for l1 in range(1,4):
        for l2 in range(1,4):
            for l3 in range(1,4):
                for l4 in range(1,4):
                    if l1 + l2 + l3 + l4 == L:
                        splits.append( (l1, l2, l3, l4) )
    # Process each split
    for split in splits:
        l1, l2, l3, l4 = split
        # Split the string into parts
        a_str = s[0:l1]
        b_str = s[l1: l1+l2]
        c_str = s[l1+l2: l1+l2+l3]
        d_str = s[l1+l2+l3: l1+l2+l3+l4]
        # Check each part for validity
        valid = True
        for part in [a_str, b_str, c_str, d_str]:
            if len(part) == 0:
                valid = False
                break
            # Check leading zero
            if len(part) > 1 and part[0] == '0':
                valid = False
                break
            # Check numeric value 0-255
            num = int(part)
            if num < 0 or num > 255:
                valid = False
                break
        if valid:
            ip = f"{int(a_str)}.{int(b_str)}.{int(c_str)}.{int(d_str)}"
            valid_ips.add(ip)

# Convert the set to a sorted list for consistent output, but problem allows any order
sorted_ips = sorted(valid_ips)
print(len(sorted_ips))
for ip in sorted_ips:
    print(ip)

