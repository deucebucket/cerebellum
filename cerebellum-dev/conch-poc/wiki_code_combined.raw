The code steps are:

Read T.

For each T:

Read initial_text.

Read M.

Read M commands.

Process each command.

Output the final text with ^.

Now, the code.

But note that in Python, strings are immutable, so using a list to represent the text.

So:

text = list(initial_text)

cursor = 0

Then process each command.

Now, code:

import sys

def process_commands(initial_text, commands):
    text = list(initial_text)
    cursor = 0
    for cmd_line in commands:
        parts = cmd_line.split(' ', 1)
        cmd = parts[0]
        arg = parts[1] if len(parts) > 1 else None
        if cmd == 'insert':
            insert_text = arg[1:-1]  # strip quotes
            text[cursor:cursor] = list(insert_text)
            cursor += len(insert_text)
        elif cmd == 'forward':
            if arg == 'char':
                cursor = min(cursor +1, len(text))
            elif arg == 'word':
                # forward word
                sub = text[cursor:]
                i = 0
                while i < len(sub) and sub[i] == ' ':
                    i +=1
                if i == len(sub):
                    cursor = len(text)
                else:
                    while i < len(sub) and sub[i] != ' ':
                        i +=1
                    cursor += i
        elif cmd == 'backward':
            if arg == 'char':
                cursor = max(cursor -1, 0)
            elif arg == 'word':
                # backward word
                i = cursor -1
                while i >=0 and text[i] == ' ':
                    i -=1
                if i <0:
                    cursor =0
                else:
                    start = i
                    while start >=0 and text[start] != ' ':
                        start -=1
                    cursor = start +1
        elif cmd == 'delete':
            if arg == 'char':
                if cursor < len(text):
                    del text[cursor]
            elif arg == 'word':
                sub = text[cursor:]
                i =0
                while i < len(sub) and sub[i] == ' ':
                    i +=1
                if i < len(sub):
                    while i < len(sub) and sub[i] != ' ':
                        i +=1
                    del text[cursor:cursor+i]
        # else: ignore invalid commands (but according to problem, input is valid)
    # construct output
    return ''.join(text[:cursor]) + '^' + ''.join(text[cursor:])

def main():
    import sys
    input = sys.stdin.read().split('\n')
    ptr =0
    T = int(input[ptr])
    ptr +=1
    for _ in range(T):
        initial = input[ptr].strip('\n')
        ptr +=1
        M = int(input[ptr].strip())
        ptr +=1
        commands = []
        for __ in range(M):
            cmd = input[ptr].strip('\n')
            commands.append(cmd)
            ptr +=1
