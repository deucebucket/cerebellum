import math

n = int(input())

circles = [tuple(map(int, input().split())) for _ in range(n)]

v = 0

# for each circle, count the number of intersection points it has (sum over all pairs)
arc_counts = [0] * n

for i in range(n):

    for j in range(i+1, n):

        c1 = circles[i]

        c2 = circles[j]

        x1, y1, r1 = c1

        x2, y2, r2 = c2

        dx = x1 - x2

        dy = y1 - y2

        d_sq = dx*dx + dy*dy

        sum_r = r1 + r2

        sum_r_sq = sum_r * sum_r

        diff_r = abs(r1 - r2)

        diff_r_sq = diff_r * diff_r

        if d_sq > sum_r_sq:

            p = 0

        elif d_sq < diff_r_sq:

            p = 0

        elif d_sq == sum_r_sq or d_sq == diff_r_sq:

            p = 1

        else:

            p = 2

        v += p

        arc_counts[i] += p

        arc_counts[j] += p

e = sum(arc_counts)

f = e - v + 2

print(f)

