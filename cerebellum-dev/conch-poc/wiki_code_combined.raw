import sys
from collections import defaultdict

n = int(sys.stdin.readline())
a = list(map(int, sys.stdin.readline().split()))

def find_solution(limit):
    sum_map = defaultdict(list)
    for i in range(limit):
        for j in range(i+1, limit):
            s = a[i] + a[j]
            for (x, y) in sum_map[s]:
                if x != i and x != j and y != i and y != j:
                    print("YES")
                    print(x+1, y+1, i+1, j+1)
                    return True
            sum_map[s].append( (i, j) )
    return False

if n >= 4000:
    # process first 4000 elements
    if not find_solution(4000):
        # This should not happen, but handle it to avoid error
        print("YES")
