import math

n, x0, y0 = map(int, input().split())

directions = set()

for _ in range(n):
    xi, yi = map(int, input().split())
    dx = xi - x0
    dy = yi - y0
    
    g = math.gcd(abs(dx), abs(dy))
    if g ==0:
        # but problem says no stormtrooper is at (x0,y0)
        continue
    dx_reduced = dx // g
    dy_reduced = dy // g
    
    # normalize the direction
    if dx_reduced ==0:
        # vertical line, make dy_reduced positive
        if dy_reduced <0:
            dy_reduced = -dy_reduced
    else:
        if dx_reduced <0:
            dx_reduced = -dx_reduced
            dy_reduced = -dy_reduced
    
    directions.add( (dx_reduced, dy_reduced) )

print( len(directions) )

