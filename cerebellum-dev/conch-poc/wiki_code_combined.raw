    def find(self, x):

        if self.parent[x] != x:

            self.parent[x] = self.find(self.parent[x])

        return self.parent[x]

    def union(self, x, y):

        fx = self.find(x)

        fy = self.find(y)

        if fx != fy:

            self.parent[fy] = fx

