Thus, the code:

import sys
import random
from collections import defaultdict

def main():
    random.seed(42)
    n, m = map(int, sys.stdin.readline().split())
    max_n = n + 1
    hash_list = [0] * (max_n + 1)
    for i in range(1, max_n + 1):
        hash_list[i] = random.getrandbits(64)
    
    adj = [[] for _ in range(max_n + 1)]
    edges = []
    for _ in range(m):
        u, v = map(int, sys.stdin.readline().split())
        if u > v:
            u, v = v, u
        edges.append( (u, v) )
        adj[u].append(v)
        adj[v].append(u)
    
    xor_hash = [0] * (max_n + 1)
    for i in range(1, n+1):
        h = 0
        for friend in adj[i]:
            h ^= hash_list[friend]
        xor_hash[i] = h
    
    # Case a
    freq = defaultdict(int)
    for i in range(1, n+1):
        freq[xor_hash[i]] += 1
    
    same_edges = defaultdict(int)
    for u, v in edges:
        if xor_hash[u] == xor_hash[v]:
            same_edges[xor_hash[u]] += 1
    
    case_a = 0
    for h in freq:
        k = freq[h]
        case_a += k * (k - 1) // 2
    # Subtract the edges in same_edges
    same_edges_total = sum(same_edges.values())
    case_a -= same_edges_total
    
    # Case b
    case_b = 0
    for u, v in edges:
        if (xor_hash[u] ^ hash_list[v]) == (xor_hash[v] ^ hash_list[u]):
            case_b += 1
    
    total = case_a + case_b
    print(total)

if __name__ == "__main__":
    main()
