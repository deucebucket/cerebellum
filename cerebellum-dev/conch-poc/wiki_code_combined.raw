Now, code:

binary = input().strip()

digit_map = {
    '0': ' ',
    '1': 'A',
    '2': 'B',
    '3': 'C',
    '4': 'D',
    '5': 'E',
    '6': 'F',
    '7': 'G'
}

# Split into integer and fractional parts
if '.' in binary:
    integer_part, fractional_part = binary.split('.')
else:
    integer_part = binary
    fractional_part = ''

# Process integer part to octal
if not integer_part:
    # Handle case where integer part is empty (like input is .111)
    integer_octal = '0'
else:
    pad_length = (3 - (len(integer_part) % 3)) % 3
    padded = integer_part.zfill(len(integer_part) + pad_length)
    groups = [padded[i:i+3] for i in range(0, len(padded), 3)]
    integer_octal = ''.join(str(int(group, 2)) for group in groups)

# Process fractional part to octal
fractional_octal = ''
if fractional_part:
    pad_length = (3 - (len(fractional_part) % 3)) % 3
    padded = fractional_part.ljust(len(fractional_part) + pad_length, '0')
    groups = [padded[i:i+3] for i in range(0, len(padded), 3)]
    fractional_octal = ''.join(str(int(group, 2)) for group in groups)

# Generate letters for integer part
integer_letters = ''.join(digit_map[d] for d in integer_octal)

# Generate letters for fractional part
fractional_letters = ' '.join(digit_map[d] for d in fractional_octal) if fractional_octal else ''

# Combine the octal parts
octal_number = integer_octal
if fractional_octal:
    octal_number += '.' + fractional_octal

# Combine the letters parts
letters_output = integer_letters
if fractional_letters:
    letters_output += ' ' + fractional_letters

# Print the result
print(f"{octal_number} {letters_output}")

