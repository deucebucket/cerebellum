```python
import sys

def main():
    input = sys.stdin.read().split()
    T = int(input[0])
    for i in range(1, T+1):
        K = int(input[i])
        if K == 1:
            print(0)
            continue
        n = K - 1
        digits = []
        if n == 0:
            digits = [0]
        else:
            while n > 0:
                digits.append(n % 5)
                n = n // 5
            digits = digits[::-1]
        s = ''.join(str(2 * d) for d in digits)
        print(s)

if __name__ == "__main__":
    main()
```
