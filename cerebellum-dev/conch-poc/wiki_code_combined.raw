import math

t = int(input())

for _ in range(t):

    P, S = map(int, input().split())

    s = P / 4.0

    m = S / 2.0

    D = s**2 - 3 * m

    sqrt_D = math.sqrt(D)

    a1 = (s + sqrt_D) / 3.0

    a2 = (s - sqrt_D) / 3.0

