import sys
from collections import deque

def main():
    input = sys.stdin.read().split()
    ptr = 0
    N = int(input[ptr]); ptr +=1
    M = int(input[ptr]); ptr +=1
    Q = int(input[ptr]); ptr +=1

    adj = [[] for _ in range(N)]
    for _ in range(M):
        f = int(input[ptr]); ptr +=1
        t = int(input[ptr]); ptr +=1
        p = int(input[ptr]); ptr +=1
        adj[f].append( (t, p) )
        adj[t].append( (f, p) )

    # Compute distance and collect cycle_xors
    distance = [None] * N
    distance[0] = 0
    q = deque([0])
    cycle_xors = []

    while q:
        u = q.popleft()
        for (v, p) in adj[u]:
            if distance[v] is None:
                distance[v] = distance[u] ^ p
                q.append(v)
            else:
                # Check if it's a back edge (not parent)
                # Wait, but since it's undirected, the parent is tracked implicitly.
                # So, if we process u's edge to v, and v is already visited, but v is not the parent of u, then it's a back edge.
                # But how to check that?

                # Well, the BFS tree is a tree. For any node u, when we process its edges, the first time a node is visited, it's added to the queue. So when processing u's edges, if v is already visited, then either v is the parent (in the BFS tree), or it's a non-parent, which would form a cycle.

                # So how to avoid adding the parent's back edge.

                # For example, when u is processed, and v is the parent of u (since in BFS, the parent is the first to discover u), then when we process the edge u -> v, v is already visited, but it's the parent. So the cycle_xor would be (distance[u] ^ p) XOR distance[v]. But since distance[v] is the parent's distance, and distance[u] = distance[v] ^ p (the edge from v to u with p). So (distance[u] ^ p) is distance[v], so XOR with distance[v] gives zero. So the cycle_xor is zero, which is not added to cycle_xors.

                # So, in code, we can proceed to compute the cycle_xor, and add it to cycle_xors only if it's non-zero.

                # So compute cycle_xor
                cycle_xor = distance[u] ^ p ^ distance[v]
                if cycle_xor !=0:
                    cycle_xors.append(cycle_xor)

    # Build basis using Gaussian elimination
    basis = [0] * 60
    for x in cycle_xors:
        current = x
        for i in reversed(range(60)):
            if (current >> i) & 1:
                if basis[i] == 0:
                    basis[i] = current
                    break
                else:
                    current ^= basis[i]
        # if current becomes 0, do nothing

    # For each query, compute base_xor and find max_xor
    for _ in range(Q):
        a = int(input[ptr]); ptr +=1
        b = int(input[ptr]); ptr +=1
        base_xor = distance[a] ^ distance[b]
        max_xor = base_xor
        # Now, apply the basis
        # Iterate from highest bit to lowest
        for i in reversed(range(60)):
            if basis[i] == 0:
                continue
            if (max_xor >> i) & 1 == 0:
                max_xor ^= basis[i]
        print(max_xor)

