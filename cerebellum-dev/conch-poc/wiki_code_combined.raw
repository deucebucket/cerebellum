The code would look like:

n, m = map(int, input().split())
d = list(map(int, input().split()))
edges = []
for i in range(m):
    u, v = map(int, input().split())
    edges.append( (u-1, v-1) )

constrained = [i for i in range(n) if d[i] != -1]
sum_required = sum(d[i] for i in constrained if d[i] != -1) % 2
count_unconstrained = n - len(constrained)

if count_unconstrained == 0 and sum_required % 2 == 1:
    print(-1)
    exit()

# Build a spanning tree
from collections import deque
adj = [[] for _ in range(n)]
for i in range(m):
    u, v = edges[i]
    adj[u].append( (v, i) )
    adj[v].append( (u, i) )

visited = [False]*n
parent = [ -1 ] * n
parent_edge = [ -1 ] *n 

# Choose root: unconstrained if possible
root = 0
for i in range(n):
    if d[i] == -1:
        root = i
        break

q = deque()
q.append(root)
visited[root] = True
while q:
    u = q.popleft()
    for v, e in adj[u]:
        if not visited[v]:
            visited[v] = True
            parent[v] = u
            parent_edge[v] = e
            q.append(v)

# Now, process in post-order to compute which edges to include
selected = [False]*m
degree = [0]*n

# Process nodes in post-order
stack = []
post_order = []
q = [root]
while q:
    u = q.pop()
    post_order.append(u)
    for v, e in adj[u]:
        if parent[v] == u and not visited[v]:
            visited[v] = True
            q.append(v)

post_order.reverse()

for u in post_order:
    if u == root:
        continue
    current_parity = degree[u] %2 
    required_parity = d[u] if d[u] != -1 else 0
    if current_parity != required_parity:
        selected[parent_edge[u]] = True
        degree[u] += 1
        degree[parent[u]] += 1

# Now check if root is constrained and has correct parity
if d[root] != -1 and degree[root] %2 != d[root]:
    print(-1)
    exit()

# Compute cross_edge_count
cross_edge_count = 0
for i in range(m):
    if selected[i]:
        u, v = edges[i]
        if (d[u] == -1) ^ (d[v] == -1):
            cross_edge_count +=1

if (sum_required + cross_edge_count) %2 != 0:
    # Need to adjust
    # Find a cross edge not in the tree
    found = False
    for i in range(m):
        u, v = edges[i]
        if (d[u] == -1) ^ (d[v] == -1) and parent_edge[u] != i and parent_edge[v] != i:
            selected[i] = not selected[i]
            found = True
            break
    if not found:
        print(-1)
        exit()

# Now collect the selected edges
result = []
for i in range(m):
    if selected[i]:
        result.append(i+1)

print(len(result))
for x in result:
    print(x)

