So, code for solve_2sat:

def solve_2sat(n, clauses):

    # Build implication graph.

    num_nodes = 2 * n

    adj = [[] for _ in range(num_nodes)]

    reverse_adj = [[] for _ in range(num_nodes)]

    for a, b in clauses:

        # Add -a => b

        # and -b => a.

        lit_a = a

        lit_b = b

        # Convert to indexes.

        def to_idx(lit):

            if lit >0:

                return 2*(lit-1)

            else:

                return 2*(-lit-1)+1

        idx_na = to_idx(-lit_a)

        idx_b = to_idx(lit_b)

        adj[idx_na].append(idx_b)

        reverse_adj[idx_b].append(idx_na)

        idx_nb = to_idx(-lit_b)

        idx_a = to_idx(lit_a)

        adj[idx_nb].append(idx_a)

        reverse_adj[idx_a].append(idx_nb)

    # Kosaraju's algorithm.

    visited = [False] * num_nodes

    order = []

    def dfs(u):

        stack = [(u, False)]

        while stack:

            node, processed = stack.pop()

            if processed:

                order.append(node)

                continue

            if visited[node]:

                continue

            visited[node] = True

            stack.append((node, True))

            for v in adj[node]:

                if not visited[v]:

                    stack.append((v, False))

    for i in range(num_nodes):

        if not visited[i]:

            dfs(i)

    visited = [False] * num_nodes

    component = [0] * num_nodes

    current = 0

    def reverse_dfs(u, current):

        stack = [u]

        visited[u] = True

        component[u] = current

        while stack:

            node = stack.pop()

            for v in reverse_adj[node]:

                if not visited[v]:

                    visited[v] = True

                    component[v] = current

                    stack.append(v)

    for node in reversed(order):

        if not visited[node]:

            reverse_dfs(node, current)

            current +=1

    assignment = [0] * n

    for i in range(n):

        pos_lit = 2 * i

        neg_lit = 2 * i + 1

        if component[pos_lit] == component[neg_lit]:

            return (False, None)

        # If pos_lit's component is after neg_lit's in the order, then we set to true.

        # Because in Kosaraju's algorithm, components are processed in reverse order.

        # So if pos_lit's component is higher than neg_lit's component, then pos_lit is in a later component.

        assignment[i] = 1 if component[pos_lit] > component[neg_lit] else 0

    return (True, assignment)

Wait, but the component numbers are assigned in the order of processing. Components processed earlier have lower numbers. So, if the component of pos_lit has a higher number than the component of neg_lit, then pos_lit's component is processed later in the reverse pass. So, in the reverse topological order, the component of pos_lit comes after the component of neg_lit. Hence, we assign true to the variable.

Yes.

Now, the code to check if an assignment satisfies a list of clauses.

def check_assignment(assignment, clauses):

    for a, b in clauses:

        # Check if a or b is true.

        val_a = None

        if a >0:

            val_a = assignment[a-1]

        else:

            val_a = 1 - assignment[-a -1]

        val_b = None

        if b >0:

            val_b = assignment[b-1]

        else:

            val_b = 1 - assignment[-b -1]

        if not (val_a or val_b):

            return False

    return True

So, for each clause (a, b), val_a is the value of the literal a in the assignment, and similarly for val_b. If either is true, the clause is satisfied.

