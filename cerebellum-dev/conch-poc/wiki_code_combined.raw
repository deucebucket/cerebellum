   Read k and p.

   i = k-1

   old_char = s[i]

   if old_char == p: no change, so output current count and continue.

   else:

      # Subtract the existing pairs involving i

      # Left pair (i-1, i)

      if i > 0 and s[i-1] == '.' and old_char == '.':

          count -= 1

      # Right pair (i, i+1)

      if i < L-1 and old_char == '.' and s[i+1] == '.':

          count -= 1

      # Update the character

      s[i] = p

      # Add new pairs involving i

