    # Check a2

    c2 = s - 2*a2

    if a2 > 1e-9 and c2 > 1e-9:

        volumes.append(a2**2 * c2)

    # Find maximum volume

    max_vol = max(volumes)

    # Round to two decimal places

    print("{0:.2f}".format(max_vol))

