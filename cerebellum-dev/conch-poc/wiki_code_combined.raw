```python
import itertools

n = int(input())
digits = list(map(int, input().split()))
required_digits = set(digits)
palindromes = []

# Generate even-length palindromes
for L in range(4, 13):
    if L % 2 != 0:
        continue
    k = L // 2
    if len(required_digits) > k:
        continue
    for sequence in itertools.product(digits, repeat=k):
        if set(sequence) == required_digits:
            s = ''.join(map(str, sequence)) + ''.join(map(str, reversed(sequence)))
            palindromes.append(s)

# Generate odd-length palindromes
for L in range(5, 13, 2):
    k = (L - 1) // 2
    if len(required_digits) > (k + 1):
        continue
    for d in required_digits:
        other_digits = required_digits - {d}
        for sequence in itertools.product(other_digits, repeat=k):
            s = ''.join(map(str, sequence)) + str(d) + ''.join(map(str, reversed(sequence)))
            palindromes.append(s)

valid_ips = set()

for s in palindromes:
    L = len(s)
    splits = []
    for l1 in range(1, 4):
        for l2 in range(1, 4):
            for l3 in range(1, 4):
                for l4 in range(1, 4):
                    if l1 + l2 + l3 + l4 == L:
                        splits.append((l1, l2, l3, l4))
    for split in splits:
        l1, l2, l3, l4 = split
        parts = []
        current = 0
        valid = True
        for length in [l1, l2, l3, l4]:
            part = s[current:current+length]
            current += length
            if len(part) == 0:
                valid = False
                break
            if len(part) > 1 and part[0] == '0':
                valid = False
                break
            num = int(part)
            if not (0 <= num <= 255):
                valid = False
                break
            parts.append(part)
        if valid and len(parts) == 4:
            ip = f"{int(parts[0])}.{int(parts[1])}.{int(parts[2])}.{int(parts[3])}"
            valid_ips.add(ip)

sorted_ips = sorted(valid_ips)
print(len(sorted_ips))
for ip in sorted_ips:
    print(ip)
```
 = = Credits = = 

 Recording and management 

 Recorded at Sony Music Studios ( New York City , New York } ) 

