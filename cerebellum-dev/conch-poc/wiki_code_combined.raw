So code:

import math

t = int(input())

for _ in range(t):

    a, b, q = map(int, input().split())

    # compute LCM of a and b

    gcd = math.gcd(a, b)

    lcm = a * b // gcd

    period = lcm

    # precompute bad list

    bad_list = []

    for x in range(period):

        mod1 = (x % a) % b

        mod2 = (x % b) % a

        if mod1 != mod2:

            bad_list.append(x)

    m = len(bad_list)

    # create bad array and prefix sum

    bad = [False] * period

    for x in bad_list:

        bad[x] = True

    prefix = [0] * (period +1)

    for i in range(period):

        prefix[i+1] = prefix[i] + (1 if bad[i] else 0)

    # process queries

    res = []

    for __ in range(q):

        l, r = map(int, input().split())

        total = r - l +1

        full_cycles = total // period

        rem = total % period

        count = full_cycles * m

        if rem !=0:

            start_part = l + full_cycles * period

            end_part = start_part + rem -1

            # compute low and high mod period

            low = start_part % period

            high = end_part % period

            if low <= high:

                cnt = prefix[high +1] - prefix[low]

            else:

                cnt = (prefix[period] - prefix[low]) + (prefix[high +1] - prefix[0])

            count += cnt

        res.append(str(count))

    print(' '.join(res), end=' ')

