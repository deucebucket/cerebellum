So the code can be written as:

for each test case:

    n, k = map(int, input().split())

    h = list(map(int, input().split()))

    positions = []

    current_h = [x for x in h]

    m_steps =0

    while True:

        # Check if current_h is non-increasing

        non_increasing = True

        for i in range(n-1):

            if current_h[i] < current_h[i+1]:

                non_increasing = False

                break

        if non_increasing:

            break

        # Find the first i where current_h[i] < current_h[i+1]

        stop_i = -1

        for i in range(n-1):

            if current_h[i] < current_h[i+1]:

                stop_i = i

                break

        if stop_i == -1:

            break

        # Record the stopping position (1-based)

        positions.append(stop_i +1)

        current_h[stop_i] +=1

        m_steps +=1

    if k > m_steps:

        print(-1)

    else:

        print(positions[k-1])

