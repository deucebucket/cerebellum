import sys
from collections import defaultdict, Counter

class UnionFind:
    def __init__(self, size):
        self.parent = list(range(size + 1))  # 1-based indexing

    def find(self, x):
        if self.parent[x] != x:
            self.parent[x] = self.find(self.parent[x])
        return self.parent[x]

    def union(self, x, y):
        fx = self.find(x)
        fy = self.find(y)
        if fx != fy:
            self.parent[fy] = fx

def sieve(n):
    if n < 2:
        return []
    is_prime = [True] * (n + 1)
    is_prime[0] = is_prime[1] = False
    for i in range(2, int(n**0.5) + 1):
        if is_prime[i]:
            for j in range(i*i, n+1, i):
                is_prime[j] = False
    primes = [i for i, val in enumerate(is_prime) if val]
    return primes

s = sys.stdin.readline().strip()
n = len(s)
if n == 0:
    print("NO")
    sys.exit()

primes = sieve(n)
uf = UnionFind(n)

for p in primes:
    for i in range(p, n+1, p):
        uf.union(p, i)

groups = defaultdict(list)
for i in range(1, n+1):
    root = uf.find(i)
    groups[root].append(i)

group_list = list(groups.values())
group_list.sort(key=lambda g: -len(g))

cnt = Counter(s)
freq = sorted(cnt.values(), reverse=True)

max_group_size = max(len(g) for g in group_list) if group_list else 0
if not freq or (max_group_size > freq[0]):
    print("NO")
else:
    # Prepare sorted characters by frequency
    sorted_chars = []
    for char, count in cnt.most_common():
        sorted_chars.extend([char] * count)
    # Assign characters to groups
    res = [''] * (n + 1)  # 1-based
    ptr = 0
    for group in group_list:
        size = len(group)
        if ptr + size > len(sorted_chars):
            print("NO")
            sys.exit()
        # Assign the first character in this segment to all positions in the group
        c = sorted_chars[ptr]
        for pos in group:
            res[pos] = c
        ptr += size
    # Build the output string
    output = ''.join(res[1:n+1])
    print("YES")
    print(output)
