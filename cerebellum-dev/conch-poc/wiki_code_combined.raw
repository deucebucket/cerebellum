   # compute inv_total = 1 / total mod MOD

   inv_total = pow(total, MOD-2, MOD)

   prob_gt = (count_gt * inv_total) % MOD

   prob_eq = (count_eq * inv_total) % MOD

   # update gt_prob and eq_prob

   gt_prob = (gt_prob + eq_prob * prob_gt) % MOD

   eq_prob = (eq_prob * prob_eq) % MOD

   # if eq_prob is 0, break

   if eq_prob == 0:

      break

