import heapq

n, m, k, p = map(int, input().split())

matrix = [list(map(int, input().split())) for _ in range(n)]

row_sums = [sum(row) for row in matrix]

col_sums = [sum(col) for col in zip(*matrix)]  # transpose and sum each row (original columns)

# Compute row_cumulative
row_heap = [-s for s in row_sums]
heapq.heapify(row_heap)
row_cumulative = [0] * (k + 1)
for i in range(1, k+1):
    current = -heapq.heappop(row_heap)
    row_cumulative[i] = row_cumulative[i-1] + current
    next_val = current - p * m
    heapq.heappush(row_heap, -next_val)

# Compute column_cumulative
col_heap = [-s for s in col_sums]
heapq.heapify(col_heap)
col_cumulative = [0] * (k + 1)
for i in range(1, k+1):
    current = -heapq.heappop(col_heap)
    col_cumulative[i] = col_cumulative[i-1] + current
    next_val = current - p * n
    heapq.heappush(col_heap, -next_val)

max_total = -float('inf')
for x in range(max(0, k - len(col_cumulative) +1), min(k, len(row_cumulative)-1) +1):
    y = k - x
    if y <0 or y >= len(col_cumulative):
        continue
    current_total = row_cumulative[x] + col_cumulative[y] - x * y * p
    if current_total > max_total:
        max_total = current_total

print(max_total)

