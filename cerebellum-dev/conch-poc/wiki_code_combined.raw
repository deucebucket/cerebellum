```python
import sys
from collections import defaultdict

def main():
    sys.setrecursionlimit(1 << 25)
    n, k = map(int, sys.stdin.readline().split())
    adj = [[] for _ in range(n+1)]  # nodes are 1-based
    for _ in range(n-1):
        u, v = map(int, sys.stdin.readline().split())
        adj[u].append(v)
        adj[v].append(u)
    
    total = 0

    def dfs(u, parent):
        nonlocal total
        depth_count = defaultdict(int)
        depth_count[0] = 1  # current node
        for v in adj[u]:
            if v == parent:
                continue
            child_depth = dfs(v, u)
            temp = defaultdict(int)
            for d, cnt in child_depth.items():
                temp[d + 1] = cnt
            # Check for pairs between this child and previous children
            for d, cnt in temp.items():
                if (k - d) in depth_count:
                    total += cnt * depth_count[k - d]
            # Merge temp into depth_count
            for d, cnt in temp.items():
                depth_count[d] += cnt
        return depth_count

    dfs(1, -1)  # assuming 1 is the root
    print(total)

if __name__ == "__main__":
    main()
```

