```python
n_str = input().strip()
n = int(n_str)
original_len = len(n_str)

def generate(k):
    def backtrack(current, count4, count7):
        if len(current) == 2 * k:
            yield current
            return
        if count4 > 0:
            yield from backtrack(current + '4', count4 - 1, count7)
        if count7 > 0:
            yield from backtrack(current + '7', count4, count7 - 1)
    return backtrack('', k, k)

current_length = original_len if original_len % 2 == 0 else original_len + 1

while True:
    k = current_length // 2
    for num_str in generate(k):
        if int(num_str) >= n:
            print(num_str)
            exit()
    current_length += 2
