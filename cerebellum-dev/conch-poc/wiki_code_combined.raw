n, m, k = map(int, input().split())

MOD = 998244353

if n ==0:

    print(0)

else:

    # Initialize DP tables

    dp_same = [[0]*(k+1) for _ in range(n+1)]

    dp_diff = [[0]*(k+1) for _ in range(n+1)]

    # base case i=1

    dp_same[1][0] = m

    for i in range(2, n+1):

        max_j = min(k, i-1)

        for j in range(0, max_j + 1):

            # Compute dp_same[i][j]

            dp_same[i][j] = (dp_same[i-1][j] + dp_diff[i-1][j]) % MOD

            # Compute dp_diff[i][j]

            if j >=1:

                dp_diff[i][j] = ( (dp_same[i-1][j-1] + dp_diff[i-1][j-1]) ) * (m-1) % MOD

            else:

                dp_diff[i][j] = 0

    print( (dp_same[n][k] + dp_diff[n][k]) % MOD )

