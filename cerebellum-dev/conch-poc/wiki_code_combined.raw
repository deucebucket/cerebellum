def is_inside(x1, y1, x2, y2, x3, y3, xp, yp):

    # Edge AB (A to B), third vertex C
    cross_p = (x2 - x1) * (yp - y1) - (y2 - y1) * (xp - x1)
    cross_c = (x2 - x1) * (y3 - y1) - (y2 - y1) * (x3 - x1)
    if cross_p * cross_c < 0:
        return False

    # Edge BC (B to C), third vertex A
    cross_p = (x3 - x2) * (yp - y2) - (y3 - y2) * (xp - x2)
    cross_c = (x3 - x2) * (y1 - y2) - (y3 - y2) * (x1 - x2)
    if cross_p * cross_c < 0:
        return False

    # Edge CA (C to A), third vertex B
    cross_p = (x1 - x3) * (yp - y3) - (y1 - y3) * (xp - x3)
    cross_c = (x1 - x3) * (y2 - y3) - (y1 - y3) * (x2 - x3)
    if cross_p * cross_c < 0:
        return False

    return True

