```python
import sys
from collections import deque

class Node:
    def __init__(self):
        self.children = {}
        self.fail = None
        self.own_a = 0
        self.sum_a = 0
        self.trans = {}
        self.best_next = None
        self.best_gain = 0

def main():
    n, l = map(int, sys.stdin.readline().split())
    a_list = list(map(int, sys.stdin.readline().split()))
    patterns = [sys.stdin.readline().strip() for _ in range(n)]
    
    # Build the automaton
    nodes = [Node()]
    root = nodes[0]
    for pattern, a in zip(patterns, a_list):
        current = root
        for c in pattern:
            if c not in current.children:
                new_node = Node()
                nodes.append(new_node)
                current.children[c] = len(nodes) - 1
            current = nodes[current.children[c]]
        current.own_a += a
    
    # Build failure links and compute sum_a
    queue = deque()
    for child in root.children.values():
        nodes[child].fail = root
        queue.append(child)
    
    while queue:
        current_idx = queue.popleft()
        current_node = nodes[current_idx]
        for c, child_idx in current_node.children.items():
            fail_node = current_node.fail
            while fail_node is not None and c not in fail_node.children:
                fail_node = fail_node.fail
            if fail_node is None:
                child_fail = root
            else:
                child_fail = fail_node.children.get(c, root)
            child_node = nodes[child_idx]
            child_node.fail = child_fail
            child_node.sum_a = child_node.own_a + (child_fail.sum_a if child_fail else 0)
            queue.append(child_idx)
    
    # Precompute transitions for each node and character
    for node in nodes:
        for c in 'abcdefghijklmnopqrstuvwxyz':
            current = node
            while True:
                if c in current.children:
                    next_idx = current.children[c]
                    break
                if current.fail is None:
                    if c in root.children:
                        next_idx = root.children[c]
                    else:
                        next_idx = root
                    break
                current = current.fail
            node.trans[c] = nodes[next_idx]
    
    # Determine best next state and gain for each node
    for node in nodes:
        best_gain = -1
        best_next = None
        for c in 'abcdefghijklmnopqrstuvwxyz':
            next_node = node.trans[c]
            if next_node.sum_a > best_gain:
                best_gain = next_node.sum_a
                best_next = next_node
            elif next_node.sum_a == best_gain and best_next is None:
                best_next = next_node
        node.best_next = best_next
        node.best_gain = best_gain
    
    # Simulate path to detect cycle
    path = []  # (current_state, total)
    seen = {}
    current_state = root
    total = 0
    step = 0
    cycle_start = -1
    cycle = []
    while True:
        if current_state in seen:
            cycle_start = seen[current_state]
            cycle = path[cycle_start:]
            break
        seen[current_state] = step
        path.append((current_state, total))
        if step >= l:
            break
        current_state = current_state.best_next
        total += current_state.best_gain
        step += 1
        if step > len(nodes) * 2:  # Prevent infinite loop in case of no cycle
            break
    
    # Compute maximum happiness
    if l < len(path):
        print(path[l][1])
        return
    
    if cycle_start == -1:
        print(path[-1][1])
        return
    
    pre_len = cycle_start
    pre_sum = path[pre_len][1]
    cycle_len = len(cycle)
    cycle_sum = (path[-1][1] - pre_sum) if cycle else 0
    remaining = l - pre_len
    
    if cycle_sum <= 0:
        if pre_len + remaining < len(path):
            print(path[pre_len + remaining][1])
        else:
            print(path[-1][1])
    else:
        full_cycles = remaining // cycle_len
        remainder = remaining % cycle_len
        total = pre_sum + full_cycles * cycle_sum
        if remainder > 0:
            if pre_len + remainder < len(path):
                total += path[pre_len + remainder][1] - pre_sum
            else:
                total += cycle_sum
        print(total)

if __name__ == "__main__":
    main()
```
