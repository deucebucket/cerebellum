import sys
from collections import deque

def main():
    n = int(sys.stdin.readline())
    nodes = [None] * (n + 1)  # nodes[1..n]
    original_val = [0] * (n + 1)
    for i in range(1, n+1):
        parts = sys.stdin.readline().split()
        if parts[0] == 'IN':
            original_val[i] = int(parts[1])
            nodes[i] = ('IN',)
        else:
            type_ = parts[0]
            children = list(map(int, parts[1:]))
            nodes[i] = (type_, children)
    
    # Compute original_val for non-IN nodes using post-order traversal.
    stack = []
    visited = [False] * (n + 1)
    stack.append(1)
    # To avoid recursion, use iterative post-order.
    # We can use a stack with (node, visited) flag.
    # Alternative approach: use a stack that processes children first.
    # Here's an alternative approach for iterative post-order:
    post_order = []
    stack = [(1, False)]
    while stack:
        node, done = stack.pop()
        if done:
            post_order.append(node)
            if nodes[node][0] != 'IN':
                type_, children = nodes[node]
                if type_ == 'AND':
                    original_val[node] = original_val[children[0]] & original_val[children[1]]
                elif type_ == 'OR':
                    original_val[node] = original_val[children[0]] | original_val[children[1]]
                elif type_ == 'XOR':
                    original_val[node] = original_val[children[0]] ^ original_val[children[1]]
                elif type_ == 'NOT':
                    original_val[node] = 1 - original_val[children[0]]
            continue
        if nodes[node][0] == 'IN':
            post_order.append(node)
            continue
        stack.append( (node, True) )
        type_, children = nodes[node]
        # Push children in reverse order to process them in order.
        for child in reversed(children):
            stack.append( (child, False) )
    
    # Compute sensitivity.
    sensitivity = [0] * (n +1)
    sensitivity[1] = 1
    q = deque([1])
    while q:
        u = q.popleft()
        if nodes[u][0] == 'IN':
            continue
        type_, children = nodes[u]
        s = sensitivity[u]
        if type_ == 'AND':
            a = original_val[children[0]]
            b = original_val[children[1]]
            c0 = children[0]
            c1 = children[1]
            sensitivity[c0] = s * b
            sensitivity[c1] = s * a
            for child in children:
                if nodes[child][0] != 'IN':
                    q.append(child)
        elif type_ == 'OR':
            a = original_val[children[0]]
            b = original_val[children[1]]
            sensitivity[children[0]] = s * (1 - b)
            sensitivity[children[1]] = s * (1 - a)
            for child in children:
                if nodes[child][0] != 'IN':
                    q.append(child)
        elif type_ == 'XOR':
            sensitivity[children[0]] = s * 1
            sensitivity[children[1]] = s * 1
            for child in children:
                if nodes[child][0] != 'IN':
                    q.append(child)
        elif type_ == 'NOT':
            c = children[0]
            sensitivity[c] = s * 1
            if nodes[c][0] != 'IN':
                q.append(c)
    
    original_output = original_val[1]
    result = []
    for i in range(1, n+1):
        if nodes[i][0] == 'IN':
            res = original_output ^ (sensitivity[i] % 2)  # since sensitivity could be 0 or 1.
            result.append(str(res))
    print(''.join(result))

if __name__ == "__main__":
    main()

