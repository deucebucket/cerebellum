Code skeleton:

import sys
import math

n, m = map(int, sys.stdin.readline().split())

edges = []
adj = [[] for _ in range(n+1)]  # 1-based indexing

for _ in range(m):
    u, v = map(int, sys.stdin.readline().split())
    edges.append((u, v))
    adj[u].append(v)
    adj[v].append(u)

coords = []
for _ in range(n):
    x, y = map(int, sys.stdin.readline().split())
    coords.append((x, y))

# Now, for each vertex, sort its adjacency list in counter-clockwise order.

for u in range(1, n+1):
    # Sort adj[u] based on the angle around u.
    # Get the coordinates of u.
    xu, yu = coords[u-1]
    # For each v in adj[u], compute the angle.
    adj_list = adj[u]
    angles = []
    for v in adj_list:
        dx = coords[v-1][0] - xu
        dy = coords[v-1][1] - yu
        angle = math.atan2(dy, dx)
        angle = (angle + 2 * math.pi) % (2 * math.pi)
        angles.append(angle)
    # Sort adj_list based on angles.
    sorted_adj = sorted(zip(angles, adj_list), key=lambda x: x[0])
    adj[u] = [v for (a, v) in sorted_adj]

# Now, build the next pointers for each directed edge.

from collections import defaultdict

# We need to map each directed edge (u, v) to its next edge.

next_edge = {}
prev_edge = {}

# For each directed edge (u, v), find the next edge in the face.

for u in range(1, n+1):
    # Get the sorted adjacency list.
    k = len(adj[u])
    for i in range(k):
        v = adj[u][i]
        # The next edge after (u, v) is the next in the adjacency list of v.
        # Find the position of u in adj[v].
        index_in_v = adj[v].index(u)
        next_index = (index_in_v + 1) % len(adj[v])
        next_v = adj[v][next_index]
        next_edge[(u, v)] = (v, next_v)
        prev_edge[(v, next_v)] = (u, v)

# Now, find all faces.

faces = []
visited_edges = set()

for u in range(1, n+1):
    for v in adj[u]:
        if (u, v) not in visited_edges:
            face = []
            current_edge = (u, v)
            start_edge = current_edge
            while True:
                if current_edge in visited_edges:
                    break
                visited_edges.add(current_edge)
                face.append(current_edge)
                current_edge = next_edge[current_edge]
                if current_edge == start_edge:
                    break
            faces.append(face)

# For each face, collect its vertices.

face_vertices = []
face_set = []

for face in faces:
    vertices = set()
    for (u, v) in face:
        vertices.add(u)
    face_vertices.append(vertices)
    face_set.append( (face, vertices) )

# For each directed edge, store the face it belongs to.

edge_to_face = {}
for i, face in enumerate(faces):
    for e in face:
        edge_to_face[e] = i

# Now, process queries.

q = int(sys.stdin.readline())

results = []

for _ in range(q):
    parts = list(map(int, sys.stdin.readline().split()))
    k = parts[0]
    cycle = parts[1:]
    # Build the set of directed edges in the cycle.
    S = set()
    for i in range(k):
        a = cycle[i]
        b = cycle[(i+1)%k]
        S.add( (a, b) )
        S.add( (b, a) )
    # Collect initial faces.
    initial_faces = set()
    for i in range(k):
        a = cycle[i]
        b = cycle[(i+1)%k]
        # The twin edge is (b, a), which is part of the enclosed face.
        e_twin = (b, a)
        if e_twin in edge_to_face:
            face_id = edge_to_face[e_twin]
            initial_faces.add( face_id )
    # Perform BFS to find all enclosed faces.
    visited_faces = set()
    queue = []
    for fid in initial_faces:
        if fid not in visited_faces:
            visited_faces.add(fid)
            queue.append(fid)
    while queue:
        fid = queue.pop(0)
        # Iterate through all edges of the face.
        face = faces[fid]
        for e in face:
            u, v = e
            # Check if this edge is in S.
            if (u, v) not in S:
                # The twin edge is (v, u).
                twin_e = (v, u)
                if twin_e in edge_to_face:
                    adj_face_id = edge_to_face[twin_e]
                    if adj_face_id not in visited_faces:
                        visited_faces.add(adj_face_id)
                        queue.append(adj_face_id)
    # Collect all vertices in visited_faces and cycle.
    vertices_in = set()
    # Add cycle's vertices.
    for a in cycle:
        vertices_in.add(a)
    # Add vertices from enclosed faces.
    for fid in visited_faces:
        vertices_in.update( face_vertices[fid] )
    # The result is the size of vertices_in.
    results.append( len(vertices_in) )

print(' '.join(map(str, results)))

