import heapq

n, m, r = map(int, input().split())

car_matrices = []

for _ in range(m):

    matrix = []

    for _ in range(n):

        row = list(map(int, input().split()))

        matrix.append(row)

    car_matrices.append(matrix)

# Precompute Floyd-Warshall for each car's matrix.

car_distances = []

for c in range(m):

    dist = [row.copy() for row in car_matrices[c]]

    for k in range(n):

        for i in range(n):

            for j in range(n):

                dist[i][j] = min(dist[i][j], dist[i][k] + dist[k][j])

    car_distances.append(dist)

# Precompute best_unlimited matrix.

best_unlimited = [[float('inf')] * n for _ in range(n)]

for i in range(n):

    for j in range(n):

        best_unlimited[i][j] = min(car_distances[c][i][j] for c in range(m))

# Run Floyd-Warshall on best_unlimited.

for k in range(n):

    for i in range(n):

        for j in range(n):

            best_unlimited[i][j] = min(best_unlimited[i][j], best_unlimited[i][k] + best_unlimited[k][j])

# Precompute ans for each s, t, k.

max_k = 58  # since n is up to 60, so n-1 is 59, but we precompute up to 58.

ans = [[[float('inf')] * (max_k + 1) for _ in range(n)] for __ in range(n)]

for s in range(n):

    # Initialize the distance array.

    dist = [[[float('inf')] * m for _ in range(n)] for __ in range(max_k + 1)]

    # For each car, initial state is s with 0 changes.

    for c in range(m):

        dist[0][s][c] = 0

    # Priority queue: (time, u, car, changes)

    heap = []

    for c in range(m):

        heapq.heappush(heap, (0, s, c, 0))

    while heap:

        time, u, car, changes = heapq.heappop(heap)

        if time > dist[changes][u][car]:

            continue

        # Move to other cities using current car.

        for v in range(n):

            if u == v:

                continue

            new_time = time + car_distances[car][u][v]

            if changes <= max_k:

                if new_time < dist[changes][v][car]:

                    dist[changes][v][car] = new_time

                    heapq.heappush(heap, (new_time, v, car, changes))

        # Change car.

        if changes < max_k:

            for new_car in range(m):

                if new_car == car:

                    continue

                if time < dist[changes + 1][u][new_car]:

                    dist[changes + 1][u][new_car] = time

                    heapq.heappush(heap, (time, u, new_car, changes + 1))

    # Now, fill ans[s][t][k]

    for t in range(n):

        for k in range(max_k + 1):

            min_time = float('inf')

            for changes_used in range(k + 1):

                for c in range(m):

                    if dist[changes_used][t][c] < min_time:

                        min_time = dist[changes_used][t][c]

            ans[s][t][k] = min_time

# Process queries.

for _ in range(r):

    s, t, k = map(int, input().split())

    s -= 1

    t -= 1

    if k >= n-1:

        print(best_unlimited[s][t])

    else:

        if k > max_k:

            # This can't happen since max_k is 58 and n-1 >=58 only if n is 59 or 60.

            # So, when k >=n-1, but n-1 is 59 and max_k is 58, which is possible if n=60 and k=59.

            # Wait, no. The code sets max_k =58. So when n=60, k >=59 (n-1=59) would use best_unlimited.

            # But when n=60, k=58 is allowed. So the code's logic is correct.

            print(best_unlimited[s][t])

        else:

            print(ans[s][t][k])

