def line_segment_intersects_circle(S, E, r):

    # S and E are tuples (x, y)

    # Compute line equation ax + by + c = 0

    a = E[1] - S[1]

    b = S[0] - E[0]

    c = E[0] * S[1] - S[0] * E[1]

    # Distance from (0,0) to line is |c| / sqrt(a² + b²)

    denominator = math.hypot(a, b)

    if denominator == 0:

        # S and E are the same point, which is outside the circle (from input constraints)

        return False

    distance = abs(c) / denominator

    if distance > r:

        return False

    # Check if projection of O onto line is between S and E

    # Compute t parameter for the projection

    dx = E[0] - S[0]

    dy = E[1] - S[1]

    t_numerator = ( -S[0] * dx - S[1] * dy )

    t_denominator = dx*dx + dy*dy

    if t_denominator == 0:

        return False

    t = t_numerator / t_denominator

    # projection is at S + t*(dx, dy)

    # if t is between 0 and 1, the projection is on the segment

    if 0 <= t <= 1:

        return True

    # else, check if either S or E is inside the circle (but input says they are not)

    # but according to input constraints, their distance is > r, so no

    return False

So, this function returns True if the line segment SE intersects the circle.

Once we have that, compute the minimal distance.

Now, for the code to compute the minimal distance when the line intersects:

def compute_tangent_arc_distance(S, E, r):

    # S and E are tuples (x, y)

    # Compute distance from S and E to O

    d1 = math.hypot(S[0], S[1])

    d2 = math.hypot(E[0], E[1])

    # tangent lengths

    t1 = math.sqrt(d1**2 - r**2)

    t2 = math.sqrt(d2**2 - r**2)

    # angles of S and E

    theta_S = math.atan2(S[1], S[0])

    theta_E = math.atan2(E[1], E[0])

    # compute alpha_S and alpha_E

    alpha_S = math.asin(r / d1)

    alpha_E = math.asin(r / d2)

    # possible tangent angles for S and E

    possible_T1 = [theta_S + alpha_S, theta_S - alpha_S]

    possible_T2 = [theta_E + alpha_E, theta_E - alpha_E]

    min_distance = float('inf')

    for t1_angle in possible_T1:

        for t2_angle in possible_T2:

            # compute the minimal arc between t1_angle and t2_angle

            angle_diff = abs(t2_angle - t1_angle)

            # the actual angle is the minimal between angle_diff and 2*pi - angle_diff

            arc_angle = min(angle_diff, 2 * math.pi - angle_diff)

            arc_length = r * arc_angle

            total_distance = t1 + t2 + arc_length

            if total_distance < min_distance:

                min_distance = total_distance

    return min_distance

