```python
import math

def main():
    xp, yp, vp = map(int, input().split())
    x, y, v, r = map(int, input().split())
    
    R = math.hypot(xp, yp)
    theta0 = math.atan2(yp, xp)
    S = (x, y)
    
    left = 0.0
    right = 1e18  # Large upper bound for binary search
    
    for _ in range(100):  # Sufficient iterations for precision
        mid = (left + right) / 2
        angle_p = theta0 + (vp / R) * mid
        Ex = R * math.cos(angle_p)
        Ey = R * math.sin(angle_p)
        E = (Ex, Ey)
        
        # Check if line segment S-E intersects the forbidden circle
        a = Ey - S[1]
        b = S[0] - Ex
        c = Ex * S[1] - S[0] * Ey
        denominator = math.hypot(a, b)
        intersects = False
        if denominator != 0:
            distance = abs(c) / denominator
            if distance <= r:
                dx = Ex - S[0]
                dy = Ey - S[1]
                t_numerator = (-S[0] * dx - S[1] * dy)
                t_denominator = dx**2 + dy**2
                if t_denominator != 0:
                    t = t_numerator / t_denominator
                    if 0 <= t <= 1:
                        intersects = True
        
        if intersects:
            d1 = math.hypot(S[0], S[1])
            d2 = math.hypot(Ex, Ey)
            t1 = math.sqrt(d1**2 - r**2)
            t2 = math.sqrt(d2**2 - r**2)
            theta_S = math.atan2(S[1], S[0])
            theta_E = math.atan2(Ey, Ex)
            alpha_S = math.asin(r / d1)
            alpha_E = math.asin(r / d2)
            
            possible_T1 = [theta_S + alpha_S, theta_S - alpha_S]
            possible_T2 = [theta_E + alpha_E, theta_E - alpha_E]
            min_total = float('inf')
            
            for t1a in possible_T1:
                for t2a in possible_T2:
                    diff = abs(t2a - t1a)
                    arc_angle = min(diff, 2 * math.pi - diff)
                    total = t1 + t2 + r * arc_angle
                    if total < min_total:
                        min_total = total
            minimal_distance = min_total
        else:
            dx = Ex - S[0]
            dy = Ey - S[1]
            minimal_distance = math.hypot(dx, dy)
        
        if minimal_distance <= v * mid:
            right = mid
        else:
            left = mid
    
    print("{0:.9f}".format(right))

if __name__ == "__main__":
    main()
