So, code outline:

import math

def gcd(a, b):
    while b:
        a, b = b, a % b
    return a

n = int(input())
steps = [tuple(map(int, input().split())) for _ in range(n)]
steps.reverse()

a_num = 1
a_den = 1
b_num = 0
b_den = 1

for q, x in steps:
    if q == 1:
        # reverse multiply x: divide by x
        new_a_num = a_num
        new_a_den = a_den * x
        new_b_num = b_num
        new_b_den = b_den * x
    elif q == 2:
        # reverse add x: subtract x
        new_a_num = a_num
        new_a_den = a_den
        new_b_num = b_num - x * b_den
        new_b_den = b_den
    elif q == 3:
        # reverse subtract x: add x
        new_a_num = a_num
        new_a_den = a_den
        new_b_num = b_num + x * b_den
        new_b_den = b_den
    else:
        assert False
    
    # Reduce a fraction
    a_gcd = gcd(new_a_num, new_a_den)
    a_num = new_a_num // a_gcd
    a_den = new_a_den // a_gcd

    # Reduce b fraction
    b_gcd = gcd(new_b_num, new_b_den)
    b_num = new_b_num // b_gcd
    b_den = new_b_den // b_gcd

# Compute B
B = a_den // a_num  # since a_den must be divisible by a_num

# Compute A: (b_num / b_den) * B
A_numerator = b_num * B
A_denominator = b_den

# A must be integer
A = A_numerator // A_denominator

print(A, B)

