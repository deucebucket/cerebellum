import sys
import math
from math import gcd
from functools import reduce

def compute_spf(max_num):
    spf = list(range(max_num+1))
    for i in range(2, int(math.sqrt(max_num)) + 1):
        if spf[i] == i:
            for j in range(i*i, max_num+1, i):
                if spf[j] == j:
                    spf[j] = i
    return spf

def get_prime_factors(x, spf):
    factors = set()
    if x == 1:
        return factors
    while x != 1:
        p = spf[x]
        factors.add(p)
        while x % p == 0:
            x = x // p
    return factors

def main():
    input = sys.stdin.read().split()
    n = int(input[0])
    a = list(map(int, input[1:n+1]))
    
    current_gcd = a[0]
    for num in a[1:]:
        current_gcd = math.gcd(current_gcd, num)
    
    b = [num // current_gcd for num in a]
    
    if all(x == 1 for x in b):
        print(-1)
        return
    
    # Compute max b to determine the SPF array size
    max_b = max(b)
    if max_b == 1:
        print(-1)
        return
    
    # Precompute SPF up to max_b
    spf = compute_spf(max_b)
    
    freq = {}
    for x in b:
        if x == 1:
            continue
        primes = get_prime_factors(x, spf)
        for p in primes:
            if p in freq:
                freq[p] += 1
            else:
                freq[p] = 1
    
    if not freq:
        print(-1)
    else:
        max_freq = max(freq.values())
        print(n - max_freq)
    
if __name__ == "__main__":
    main()

