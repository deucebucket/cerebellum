    ti = t[i]
    for j in range(N):
        a, b, c = clothes[j]
        if a < ti < b:
            eligible[i].append(j)

prev_day = {}
for j in eligible[1]:
    prev_day[j] = 0

for day in range(2, D + 1):
    curr_day = {}
    eligible_prev = eligible[day - 1]
    eligible_curr = eligible[day]
    for j in eligible_curr:
        max_sum = 0
        for k in eligible_prev:
            c_k = clothes[k][2]
            c_j = clothes[j][2]
            current = prev_day[k] + abs(c_k - c_j)
            if current > max_sum:
                max_sum = current
        curr_day[j] = max_sum
    prev_day = curr_day

print(max(prev_day.values()))
